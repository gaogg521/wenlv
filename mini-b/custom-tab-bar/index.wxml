<view class="tb">
  <block wx:for="{{list}}" wx:key="path">
    <view wx:if="{{index === 0 || index === 3 || role >= 2}}"
      class="tb-item {{selected === index ? 'on' : ''}}" bindtap="tap"
      data-path="{{item.path}}" data-index="{{index}}">
      <view class="tb-ico">{{item.ico}}</view>
      <view class="tb-txt">{{item.text}}</view>
    </view>
  </block>
</view>
