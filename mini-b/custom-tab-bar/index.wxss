.tb { display: flex; background: #fff; border-top: 1rpx solid #eee; padding-bottom: env(safe-area-inset-bottom); }
.tb-item { flex: 1; text-align: center; padding: 12rpx 0 8rpx; color: #8a919c; }
.tb-item.on { color: #7b5aa6; }
.tb-ico { font-size: 36rpx; line-height: 1.2; }
.tb-txt { font-size: 22rpx; }
