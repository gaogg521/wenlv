.nav{position:fixed;top:0;left:0;right:0;z-index:90;background:#f7f6fa;color:#252037;border-bottom:1rpx solid #ece9f0}
.nav-row{position:relative;display:flex;align-items:center;padding-left:24rpx;box-sizing:border-box;gap:12rpx}
.nav-brand{display:flex;align-items:center;gap:14rpx;font-size:27rpx;font-weight:650;letter-spacing:1rpx}
.brand-mark{width:46rpx;height:46rpx;line-height:46rpx;text-align:center;border-radius:15rpx;background:#4d3868;color:#f2dfbf;font-size:26rpx;font-family:Georgia,serif}
.nav-back{margin:0;padding:0 12rpx 0 0;background:transparent;color:#5f477d;border:0;display:flex;align-items:center;gap:8rpx;font-size:25rpx;line-height:40px;min-width:130rpx;width:auto;flex-shrink:0;text-align:left}
.nav-back::after{border:0}.back-arrow{font-size:56rpx;line-height:36px;font-weight:300}
.nav-title{position:absolute;left:100px;right:100px;text-align:center;pointer-events:none;font-size:28rpx;font-weight:650;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
