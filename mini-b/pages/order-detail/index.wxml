<merchant-nav id="merchant-navigation" title="订单详情" tab="{{true}}" />
<view wx:if="{{error}}" class="card"><ui-state kind="error" title="订单详情加载失败" desc="{{error}}" bind:retry="fetch" /></view>
<block wx:if="{{order}}"><view class="hero"><view class="sub2">{{order.statusText}}</view><view class="hi">{{order.title}}</view><view class="sub2">{{order.order_no}}</view></view><view class="card"><view class="sec-title">订单与履约</view><view class="row" wx:if="{{order.depart_date}}"><text>{{order.cat === 'shop' ? '到店时段' : '出发日期'}}</text><text>{{order.depart_date}}</text></view><view class="row"><text>{{order.depart_date ? '预约人数' : '商品数量'}}</text><text>{{order.qty}} {{order.depart_date ? '人' : '件'}}</text></view><view class="row"><text>游客实付</text><text>{{order.amountText}}</text></view><view class="row"><text>自由豆补贴</text><text>{{order.subsidyText}}</text></view><view wx:if="{{order.rebook}}" class="row"><text>改签来源单</text><text>{{order.rebookOf}}</text></view><view class="row"><text>联系人</text><text>{{order.contact_name || '未填写'}}</text></view><view class="row"><text>联系电话</text><text>{{order.contactPhone || '未填写'}}</text></view><view class="row"><text>支付时间</text><text>{{order.paid_at}}</text></view></view><view class="card"><view class="sec-title">核销进度</view><view wx:for="{{order.passes}}" wx:key="id" class="row"><text>凭证 #{{item.id}}</text><text>{{item.status === 1 ? '待核销' : '已处理'}}</text></view><view wx:if="{{order.status === 30}}" class="btn" bindtap="goVerify">去扫码核销</view></view></block>
