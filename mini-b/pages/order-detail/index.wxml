<view wx:if="{{error}}" class="card"><view>{{error}}</view><view class="btn ghost" bindtap="fetch">重新加载</view></view>
<block wx:if="{{order}}"><view class="hero"><view class="sub2">{{statuses[order.status]}}</view><view class="hi">{{order.title}}</view><view class="sub2">{{order.order_no}}</view></view><view class="card"><view class="sec-title">出行与履约</view><view class="row"><text>出发日期</text><text>{{order.depart_date}}</text></view><view class="row"><text>出行人数</text><text>{{order.qty}} 人</text></view><view class="row"><text>实付金额</text><text>¥{{order.amount_pay / 100}}</text></view><view class="row"><text>联系人</text><text>{{order.contact_name || '未填写'}}</text></view><view class="row"><text>联系电话</text><text>{{order.contactPhone || '未填写'}}</text></view><view class="row"><text>支付时间</text><text>{{order.paid_at}}</text></view></view><view class="card"><view class="sec-title">核销进度</view><view wx:for="{{order.passes}}" wx:key="id" class="row"><text>凭证 #{{item.id}}</text><text>{{item.status === 1 ? '待核销' : '已处理'}}</text></view><view wx:if="{{order.status === 30}}" class="btn" bindtap="goVerify">去扫码核销</view></view></block>
