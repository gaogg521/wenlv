<merchant-nav id="merchant-navigation" title="我的门店" tab="{{true}}" />
<view class="page-heading"><view class="page-eyebrow">门店经营</view><view class="page-title">我的门店，安心经营</view><view class="page-caption">门店身份、权益与日常管理</view></view>
<view class="hero">
  <block wx:if="{{merchant}}"><view class="hi">{{merchant.name}}</view>
    <view class="sub2">商户号 {{merchant.merchant_no}}</view><view class="account-role">{{roleNames[role]}} · 已安全绑定门店</view></block>
  <block wx:else><view class="hi">绑定门店</view><view class="sub2">微信安全登录 · 凭门店邀请加入</view></block>
</view>
<view wx:for="{{applications}}" wx:key="id" class="card"><view class="sec-title">{{item.name}}</view><view>{{item.statusText}}</view><view class="note">申请编号 {{item.merchant_no}}</view></view>
<view class="card" wx:if="{{!merchant && demoAvailable}}">
  <view class="sec-title">演示体验</view>
  <view class="note" style="margin:12rpx 0 24rpx">安麓大夫第 · 朱家角 · 店长视角。模拟支付，不代表真实成交。</view>
  <button id="demo-login" class="btn demo-entry" bindtap="enterDemo" loading="{{demoBusy}}" disabled="{{demoBusy}}">一键进入演示门店</button>
</view>
<view class="card" wx:if="{{!merchant}}">
  <view class="btn" bindtap="doLogin">微信登录已有门店</view>
  <view class="note" wx:if="{{loginTip}}" style="margin-top:16rpx;color:var(--brand,#a8603f)">{{loginTip}}</view>
  <view class="sec-title" style="margin-top:24rpx">凭邀请码加入</view>
  <input value="{{inviteInput}}" bindinput="onInvite" placeholder="如 INV01234567"
    style="border:1rpx solid var(--line);border-radius:16rpx;padding:20rpx 24rpx;margin-bottom:16rpx" />
  <view class="btn ghost" bindtap="joinByInvite">加入门店</view>
  <view class="sec-title" style="margin-top:24rpx">商户自助入驻</view>
  <input value="{{applyName}}" bindinput="onApplyName" placeholder="门店名称"
    style="border:1rpx solid var(--line);border-radius:16rpx;padding:20rpx 24rpx;margin-bottom:16rpx" />
  <input value="{{applyContact}}" bindinput="onApplyContact" placeholder="联系人"
    style="border:1rpx solid var(--line);border-radius:16rpx;padding:20rpx 24rpx;margin-bottom:16rpx" />
  <input value="{{applyMobile}}" bindinput="onApplyMobile" type="number" placeholder="联系电话"
    style="border:1rpx solid var(--line);border-radius:16rpx;padding:20rpx 24rpx;margin-bottom:16rpx" />
  <view class="btn ghost" bindtap="applyMerchant">提交入驻申请</view>
  <view wx:if="{{applications.length}}" style="margin:16rpx 0">
    <view wx:for="{{applications}}" wx:key="id" class="note" style="{{item.rejected ? 'color:var(--red)' : ''}}">「{{item.name}}」{{item.statusText}}</view>
    <view wx:if="{{applications[0].rejected}}" class="note">驳回后可修改资料重新提交</view>
  </view>
  <view class="note">{{joinTip || '提交后可在此查看审核进度。'}}</view>
</view>
<block wx:else>
  <view class="card">
    <view class="row" bindtap="chooseStore"><text>切换授权门店</text><text class="v">当前门店与岗位 ›</text></view>
    <view class="row" bindtap="goHonor"><text>经营等级与荣誉</text><text class="v">等级 · 权益 · 徽章 ›</text></view>
    <view class="row" bindtap="goCredentials"><text>我的可信凭证</text><text class="v">勋章记录 ›</text></view>
    <view class="row" wx:if="{{role >= 2}}" bindtap="goSettle"><text>对账结算单</text><text class="v">›</text></view>
    <view class="row" bindtap="storeQrcode"><text>门店码</text><text class="v">{{qr ? '查看' : '生成'}} ›</text></view>
    <view class="row" wx:if="{{role >= 2}}" bindtap="copyInvite"><text>店员邀请码</text><text class="v">{{inviteCode || '生成中…'}} ⧉</text></view>
    <view id="merchant-logout" class="row" bindtap="logout"><text style="color:var(--red)">退出登录</text></view>
  </view>
</block>

<view wx:if="{{merchant && role >= 3}}" class="card"><view class="sec-title">店员管理</view><view class="note">通过邀请码加入的员工默认只能核销，老板可设置角色。</view><view wx:for="{{staff}}" wx:key="id" class="row" bindtap="changeStaff" data-id="{{item.id}}"><view><view>{{item.nickname}}</view><view class="tiny">{{item.roleText}} · {{item.status ? '在职' : '已停用'}}</view></view><view class="v">{{item.role === 3 ? '老板' : '管理 ›'}}</view></view></view>
