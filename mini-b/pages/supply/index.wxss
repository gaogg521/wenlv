.product-group{margin:18rpx 28rpx;background:#fff;border:1rpx solid #eae5ef;border-radius:24rpx;overflow:hidden}.group-heading{display:flex;align-items:center;gap:20rpx;padding:26rpx 24rpx}.group-initial{background:#f0eaf6;color:#73568b;width:76rpx;height:82rpx;border-radius:17rpx;display:flex;flex-direction:column;justify-content:center;align-items:center;font-size:32rpx;font-weight:650;flex-shrink:0}.group-initial text{font-size:18rpx;font-weight:400;margin-top:4rpx}.group-copy{flex:1;min-width:0}.group-title{font-size:27rpx;font-weight:650;color:#392c46;line-height:1.5}.group-sub{font-size:21rpx;line-height:1.5;color:#a195aa;margin-top:7rpx}.group-arrow{color:#9c84af;font-size:36rpx;margin-left:6rpx}.group-footer{display:flex;justify-content:space-between;padding:17rpx 24rpx;border-top:1rpx solid #f1edf4;color:#9d8ba9;font-size:21rpx}.group-footer text:last-child{color:#786087}.session-item{padding:24rpx;border-top:1rpx solid #eee8f3;background:#fdfcfe}.session-main,.session-bottom{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.session-date{font-size:28rpx;font-weight:600;color:#493653}.session-price{text-align:right;font-size:30rpx;font-weight:600;color:#705186;font-variant-numeric:tabular-nums}.session-bottom{margin-top:18rpx}.status-label{font-size:19rpx;font-weight:400;margin-top:8rpx}.session-bottom .group-sub{flex:1;margin:0}.compact-button{margin:0;flex-shrink:0}
