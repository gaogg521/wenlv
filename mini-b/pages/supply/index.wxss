.product-group{margin:18rpx 28rpx;background:#fffdf8;border:1rpx solid #e8dfd1;border-radius:24rpx;overflow:hidden}.group-heading{display:flex;align-items:center;gap:20rpx;padding:26rpx 24rpx}.group-initial{background:#e9eedf;color:#657c50;width:76rpx;height:82rpx;border-radius:17rpx;display:flex;flex-direction:column;justify-content:center;align-items:center;font-size:32rpx;font-weight:650;flex-shrink:0}.group-initial text{font-size:20rpx;font-weight:400;margin-top:4rpx}.group-copy{flex:1;min-width:0}.group-title{font-size:28rpx;font-weight:650;color:#3c4834;line-height:1.5}.group-sub{font-size:22rpx;line-height:1.5;color:#a0947d;margin-top:7rpx}.group-arrow{color:#9c9e7e;font-size:38rpx;margin-left:6rpx}.group-footer{display:flex;justify-content:space-between;padding:17rpx 24rpx;border-top:1rpx solid #eee7db;color:#9d9178;font-size:22rpx}.group-footer text:last-child{color:#76825f}.session-item{padding:24rpx;border-top:1rpx solid #e9e1d2;background:#fcfaf4}.session-main,.session-bottom{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.session-date{font-size:28rpx;font-weight:600;color:#47553c}.session-price{text-align:right;font-size:32rpx;font-weight:600;color:#a16c43;font-variant-numeric:tabular-nums}.session-bottom{margin-top:18rpx}.status-label{font-size:20rpx;font-weight:400;margin-top:8rpx}.session-bottom .group-sub{flex:1;margin:0}.compact-button{margin:0;flex-shrink:0}
