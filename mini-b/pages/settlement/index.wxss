.settlement-filters{margin:22rpx 28rpx;gap:10rpx}.settlement-filters .filter-chip{font-size:21rpx;padding:12rpx 15rpx}.bill-heading{display:flex;gap:16rpx;justify-content:space-between;align-items:flex-start}.bill-title{font-size:27rpx;color:#4c5b3e;font-weight:600;line-height:1.6;flex:1}.bill-heading .status-label{font-size:18rpx;flex-shrink:0}.bill-amount{display:flex;justify-content:space-between;align-items:center;margin-top:26rpx}.bill-amount>view:first-child>view{font-size:43rpx;color:#60774d;margin-top:8rpx;font-weight:600;font-variant-numeric:tabular-nums}.bill-count{font-size:22rpx;color:#a29780;text-align:right}.bill-count text{display:block;margin-top:14rpx;color:#8e7955}.settlement-paper .split-bar{height:12rpx}.settlement-paper .split-legend{line-height:1.8}.settlement-paper .btn{margin:22rpx 0 0;border-radius:13rpx;font-size:25rpx}.settlement-paper .fee-box{border-radius:13rpx;background:#f3eddf;color:#9a805a;line-height:1.7;font-size:22rpx}
