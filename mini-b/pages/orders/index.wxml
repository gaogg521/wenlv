<view wx:if="{{error}}" class="card"><view>{{error}}</view><view class="btn ghost" bindtap="retry">重新加载</view></view>
<view class="card fade-up" wx:if="{{orders.length}}">
  <view class="row" bindtap="goDetail" data-no="{{item.order_no}}" wx:for="{{orders}}" wx:key="order_no">
    <view style="flex:1;min-width:0"><b>{{item.title}}</b>
      <view class="sub">{{item.order_no}} · {{item.contact_name || '游客'}} · {{item.qty}}人</view></view>
    <view style="text-align:right;flex-shrink:0"><view class="money">¥{{item.amount_pay / 100}}</view>
      <view class="pill p{{item.status}}" style="margin-top:8rpx">{{item.statusText}}</view></view>
  </view>
</view>
<view wx:elif="{{loaded}}" class="empty"><view class="e-ico">📋</view>暂无已支付订单</view>
<view class="note">仅展示本店订单 · 游客隐私已脱敏</view>
