.order-paper{background:#fff;border:1rpx solid #eae5ef;border-radius:23rpx;margin:18rpx 28rpx;padding:24rpx}.order-top,.order-info,.order-foot{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.order-number{font-size:19rpx;color:#b1a4b9;font-family:monospace;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.order-top .status-label{flex-shrink:0}.order-title{font-size:29rpx;color:#493451;font-weight:600;line-height:1.5;margin:24rpx 0 16rpx}.order-info{font-size:23rpx;color:#a092aa}.order-price{font-size:32rpx;color:#735186;font-weight:600;font-variant-numeric:tabular-nums}.order-foot{margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid #f1edf4;font-size:21rpx;color:#a697af}.order-foot>text:last-child{color:#8b6d9b}.rebook-label{font-size:21rpx;color:#a68354;line-height:1.6;margin-top:14rpx}.load-more{margin:24rpx;text-align:center;font-size:24rpx;color:#8e719e;padding:20rpx}.order-date-filter{display:flex;align-items:center;justify-content:space-between;margin:0 32rpx;font-size:23rpx;color:#8d749c}
