.order-paper{background:#fffdf8;border:1rpx solid #e8dfd1;border-radius:23rpx;margin:18rpx 28rpx;padding:24rpx}.order-top,.order-info,.order-foot{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.order-number{font-size:19rpx;color:#a89b83;font-family:monospace;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.order-top .status-label{flex-shrink:0}.order-title{font-size:29rpx;color:#3f4c37;font-weight:600;line-height:1.5;margin:24rpx 0 16rpx}.order-info{font-size:23rpx;color:#9c917a}.order-price{font-size:32rpx;color:#a56a43;font-weight:600;font-variant-numeric:tabular-nums}.order-foot{margin-top:20rpx;padding-top:18rpx;border-top:1rpx solid #eee7db;font-size:21rpx;color:#a1957e}.order-foot>text:last-child{color:#75815f}.rebook-label{font-size:21rpx;color:#a68354;line-height:1.6;margin-top:14rpx}.load-more{margin:24rpx;text-align:center;font-size:24rpx;color:#77815f;padding:20rpx}.order-date-filter{display:flex;align-items:center;justify-content:space-between;margin:0 32rpx;font-size:23rpx;color:#7d8268}
.order-top .status-20,.order-top .status-30{background:#f4ebd7;color:#9b7b40}.order-top .status-40,.order-top .status-50{background:#e9eedf;color:#657c50}.order-top .status-60,.order-top .status-70{background:#f4e6db;color:#ac704b}
