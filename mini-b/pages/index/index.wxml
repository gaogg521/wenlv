<merchant-nav id="merchant-navigation" home="{{true}}" />
<view class="workbench">
  <view class="shop-heading">
    <view class="shop-date">{{dateLabel}}<text>向往的自由 · 商户端</text></view>
    <view class="shop-name">{{merchant ? merchant.name : '经营美好，从这里开始'}}</view>
    <view class="shop-meta"><text>{{greet}}，{{merchant ? roleLabel : '欢迎来到商户端'}}</text><text wx:if="{{merchant}}" class="role-tag">本店工作空间</text></view>
    <view class="workbench-period" wx:if="{{merchant}}"><picker range="{{periodNames}}" value="{{periodIndex}}" bindchange="filterPeriod"><view>{{periodNames[periodIndex]}}经营　⌄</view></picker><picker wx:if="{{periodIndex === 3}}" mode="date" value="{{customDate}}" end="{{today}}" bindchange="selectDate"><view>{{customDate}}　⌄</view></picker><text wx:else>可切换查看历史</text></view>
  </view>
  <view wx:if="{{err === 'login'}}" class="welcome-panel">
    <view class="welcome-title">让每一次到店，都被妥善接待</view>
    <view class="welcome-desc">绑定门店后，处理订单、管理名额，轻松完成游客核销。</view>
    <button class="welcome-button" bindtap="goLogin">登录 / 绑定门店　→</button>
  </view>
  <block wx:else>
    <view class="overview" wx:if="{{wb}}">
      <view class="overview-head"><text>{{periodLabel}}经营</text><text class="overview-caption">仅本店数据</text></view>
      <view class="overview-money" wx:if="{{role >= 2}}"><text class="currency">¥</text>{{wb.todayGmv}}<text class="money-label">所选期间流水</text></view>
      <view class="overview-money" wx:else>{{wb.myVerified}}<text class="money-label">所选期间我的核销</text></view>
      <view class="overview-bottom">
        <view bindtap="goOrders" wx:if="{{role >= 2}}"><text class="metric-value">{{wb.todayOrders}}</text><text class="metric-label">期间订单</text></view>
        <view bindtap="goRecords" wx:else><text class="metric-value">{{wb.myVerified}}</text><text class="metric-label">核销记录</text></view>
        <view bindtap="goVerify"><text class="metric-value">{{wb.pendingVerify}}</text><text class="metric-label">当前待核销凭证</text></view>
        <view class="honor-link" bindtap="goHonor"><text>{{wb.level.name || '经营荣誉'}}</text><text class="metric-label">查看门店成长　↗</text></view>
      </view>
    </view>
    <view class="loading-panel" wx:elif="{{loading}}">正在更新本店经营数据…</view>
    <view class="error-panel" wx:else><view>{{err}}</view><button bindtap="retry">重新加载</button></view>
    <view wx:if="{{wb.demo}}" class="demo-notice">联调演示环境 · 样例支付不代表真实扣款或到账</view>
    <button class="scan-action" bindtap="goVerify"><view class="scan-symbol"><view></view></view><view class="scan-copy"><view>扫码核销</view><text>游客到店 · 扫描动态凭证</text></view><text class="scan-arrow">↗</text></button>
    <view class="section-heading services-heading"><text>门店日常</text><text class="section-note">把接待安排得井井有条</text></view>
    <view class="service-grid">
      <button class="service-order" wx:if="{{role >= 2}}" bindtap="goOrders"><view class="service-icon">☰</view><view>门店订单</view><text>跟进预约与游客安排</text><view class="service-arrow">↗</view></button>
      <button class="service-stock" wx:if="{{role >= 2}}" bindtap="goSupply"><view class="service-icon">▦</view><view>库存与价格</view><text>管理团期、名额与定价</text><view class="service-arrow">↗</view></button>
      <button class="service-bill" wx:if="{{role >= 2}}" bindtap="goSettle"><view class="service-icon">≋</view><view>对账结算</view><text>核对账单与结算进度</text><view class="service-arrow">↗</view></button>
      <button class="service-record" bindtap="goRecords"><view class="service-icon">↺</view><view>核销记录</view><text>每一次接待都有记录</text><view class="service-arrow">↗</view></button>
      <button wx:if="{{role < 2}}" bindtap="goHonor"><view class="service-icon">◇</view><view>门店荣誉</view><text>查看成长与权益</text></button>
    </view>
    <view class="attention" wx:if="{{wb}}" bindtap="goVerify"><view class="attention-dot"></view><view><view>{{wb.pendingVerify ? '今天的接待，从这张凭证开始' : '接待准备就绪'}}</view><text>{{wbHint}}</text></view><text>›</text></view>
    <view class="trend-panel" wx:if="{{stats && role >= 2}}">
      <view class="section-heading"><text>所选期间订单</text><text class="week-total">{{weekTotal}} <text>单</text></text></view>
      <scroll-view scroll-x><view class="trend-chart" style="width:{{chartWidth}}rpx"><view wx:for="{{bars}}" wx:key="d" class="trend-day"><view class="trend-column"><view style="height:{{item.hp}}%"></view></view><text>{{item.dLabel}}</text></view></view></scroll-view>
    </view>
    <view class="announcement" wx:if="{{notice}}"><view class="announcement-kicker">商户资讯</view><view class="section-heading"><text>平台公告</text><text class="notice-toggle" bindtap="toggleNotice">{{noticeExpanded ? '收起 −' : '阅读全文 ↗'}}</text></view><view class="notice-body {{noticeExpanded ? 'expanded' : ''}}"><rich-text nodes="{{notice}}"></rich-text></view></view>
    <view class="review-panel" wx:if="{{stats && stats.latestReview}}"><view class="section-heading"><text>游客的声音</text><text class="review-rating">{{stats.latestReview.rating}} ★</text></view><view class="review-copy">{{stats.latestReview.content}}</view><text class="review-author">{{stats.latestReview.nickname}}</text></view>
  </block>
  <view class="growth-links" wx:if="{{merchant}}"><view bindtap="goHonor"><text>◇　等级与勋章</text><text>查看成长　↗</text></view><view bindtap="goCredentials"><text>✓　可信凭证</text><text>查看记录　↗</text></view></view>
  <view class="workbench-footer">向往的自由 · 用心经营每一次相遇</view>
</view>
