<merchant-nav id="merchant-navigation" home="{{true}}" />
<view class="workbench">
  <view class="shop-heading">
    <view class="shop-date">{{dateLabel}}<text>WANDERLUST BUSINESS</text></view>
    <view class="shop-name">{{merchant ? merchant.name : '经营美好，从这里开始'}}</view>
    <view class="shop-meta"><text>{{greet}}，{{merchant ? roleLabel : '欢迎来到商户端'}}</text><text wx:if="{{merchant}}" class="role-tag">本店工作空间</text></view>
  </view>
  <view wx:if="{{err === 'login'}}" class="welcome-panel">
    <view class="welcome-title">让每一次到店，都被妥善接待</view>
    <view class="welcome-desc">绑定门店后，处理订单、管理名额，轻松完成游客核销。</view>
    <button class="welcome-button" bindtap="goLogin">登录 / 绑定门店　→</button>
  </view>
  <block wx:else>
    <view class="overview" wx:if="{{wb}}">
      <view class="overview-head"><text>今日经营</text><text class="overview-caption">仅本店数据</text></view>
      <view class="overview-money" wx:if="{{role >= 2}}"><text class="currency">¥</text>{{wb.todayGmv}}<text class="money-label">今日流水</text></view>
      <view class="overview-money" wx:else>{{wb.myVerified}}<text class="money-label">今日我的核销</text></view>
      <view class="overview-bottom">
        <view bindtap="goOrders" wx:if="{{role >= 2}}"><text class="metric-value">{{wb.todayOrders}}</text><text class="metric-label">今日订单</text></view>
        <view bindtap="goRecords" wx:else><text class="metric-value">{{wb.myVerified}}</text><text class="metric-label">核销记录</text></view>
        <view bindtap="goVerify"><text class="metric-value">{{wb.pendingVerify}}</text><text class="metric-label">待核销凭证</text></view>
        <view class="honor-link" bindtap="goHonor"><text>{{wb.level.name || '经营荣誉'}}</text><text class="metric-label">查看门店成长　↗</text></view>
      </view>
    </view>
    <view class="loading-panel" wx:elif="{{loading}}">正在更新本店经营数据…</view>
    <view class="error-panel" wx:else><view>{{err}}</view><button bindtap="retry">重新加载</button></view>
    <button class="scan-action" bindtap="goVerify"><view class="scan-symbol"><view></view></view><view class="scan-copy"><view>扫码核销</view><text>游客到店 · 扫描动态凭证</text></view><text class="scan-arrow">↗</text></button>
    <view class="section-heading"><text>常用服务</text><text class="section-note">让日常更有条理</text></view>
    <view class="service-grid">
      <button wx:if="{{role >= 2}}" bindtap="goOrders"><view class="service-icon">☰</view><view>门店订单</view><text>查看与跟进</text></button>
      <button wx:if="{{role >= 2}}" bindtap="goSupply"><view class="service-icon">▦</view><view>库存与价格</view><text>名额与团期</text></button>
      <button wx:if="{{role >= 2}}" bindtap="goSettle"><view class="service-icon">≋</view><view>对账结算</view><text>账单与回单</text></button>
      <button bindtap="goRecords"><view class="service-icon">↺</view><view>核销记录</view><text>每一笔可追溯</text></button>
      <button wx:if="{{role < 2}}" bindtap="goHonor"><view class="service-icon">◇</view><view>门店荣誉</view><text>查看成长与权益</text></button>
    </view>
    <view class="attention" wx:if="{{wb}}" bindtap="goVerify"><view class="attention-dot"></view><view><view>{{wb.pendingVerify ? '今天的接待，从这张凭证开始' : '接待准备就绪'}}</view><text>{{wb.pendingVerify ? wb.pendingVerify + ' 张凭证待核销，到店后请引导游客出示动态码' : '有游客到店时，可从上方进入扫码核销'}}</text></view><text>›</text></view>
    <view class="announcement" wx:if="{{notice}}"><view class="section-heading"><text>平台公告</text><text class="notice-toggle" bindtap="toggleNotice">{{noticeExpanded ? '收起 −' : '展开 +'}}</text></view><view class="notice-body {{noticeExpanded ? 'expanded' : ''}}"><rich-text nodes="{{notice}}"></rich-text></view></view>
    <view class="trend-panel" wx:if="{{stats && role >= 2}}">
      <view class="section-heading"><text>近 7 日订单</text><text class="week-total">{{weekTotal}} <text>单</text></text></view>
      <view class="trend-chart"><view wx:for="{{bars}}" wx:key="d" class="trend-day"><view class="trend-column"><view style="height:{{item.hp}}%"></view></view><text>{{item.dLabel}}</text></view></view>
    </view>
    <view class="review-panel" wx:if="{{stats && stats.latestReview}}"><view class="section-heading"><text>游客的声音</text><text class="review-rating">{{stats.latestReview.rating}} ★</text></view><view class="review-copy">{{stats.latestReview.content}}</view><text class="review-author">{{stats.latestReview.nickname}}</text></view>
  </block>
  <view class="workbench-footer">向往的自由 · 用心经营每一次相遇</view>
</view>
