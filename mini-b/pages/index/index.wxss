page{background:#f7f6fa}.workbench{padding:32rpx 28rpx 36rpx}.workbench button{width:100%;min-width:0;box-sizing:border-box}.shop-date{display:flex;justify-content:space-between;align-items:center;font-size:23rpx;color:#82798e}.shop-date text{font-size:16rpx;letter-spacing:2rpx;color:#a29aa9}.shop-name{font-size:42rpx;font-weight:700;line-height:1.4;letter-spacing:-1rpx;color:#292035;margin-top:14rpx}.shop-meta{display:flex;justify-content:space-between;align-items:center;margin:12rpx 0 20rpx;font-size:24rpx;color:#82798e}.role-tag{font-size:19rpx;background:#eeebf2;padding:6rpx 13rpx;border-radius:8rpx;color:#6c5c7a}.notice-body{max-height:126rpx;overflow:hidden;font-size:24rpx;line-height:1.7;color:#8f8198}.notice-body.expanded{max-height:none}.notice-toggle{font-size:22rpx;color:#8a719c;font-weight:400;padding:8rpx 0 8rpx 24rpx}.workbench-period{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx;font-size:23rpx;color:#8b6b9b}.workbench-period>text{font-size:20rpx;color:#b09eb9}.growth-links{margin-top:22rpx;background:white;border:1rpx solid #eae5ef;border-radius:23rpx;padding:4rpx 24rpx}.growth-links>view{display:flex;justify-content:space-between;font-size:25rpx;color:#79598a;padding:22rpx 0;border-bottom:1rpx solid #f0eaf5}.growth-links>view:last-child{border:0}.growth-links>view>text:last-child{font-size:21rpx;color:#b09abb}
.overview{border-radius:28rpx;padding:27rpx 30rpx 26rpx;background:linear-gradient(115deg,#30263f,#594370);color:#fff;box-shadow:0 12rpx 26rpx #3c2d4c1a}.overview-head{display:flex;justify-content:space-between;font-size:24rpx;color:#e2d8eb}.overview-caption{font-size:20rpx;color:#c0afce}.overview-money{display:flex;align-items:baseline;font-size:64rpx;line-height:1.3;letter-spacing:1rpx;font-weight:650;margin:12rpx 0 23rpx;font-variant-numeric:tabular-nums}.currency{font-size:32rpx;margin-right:8rpx}.money-label{font-size:20rpx;color:#c7b9d3;margin-left:16rpx;font-weight:400;letter-spacing:0}.overview-bottom{display:flex;align-items:center;border-top:1rpx solid #ffffff24;padding-top:22rpx;gap:20rpx}.overview-bottom>view{flex:1;min-width:0}.metric-value{font-size:32rpx;font-weight:600;display:block}.metric-label{display:block;font-size:19rpx;color:#c7b9d3;margin-top:7rpx}.honor-link{font-size:23rpx;color:#efdbb2;text-align:right;line-height:1.4}
button::after{border:0}button{font-weight:400}.scan-action{display:flex;align-items:center;text-align:left;background:#eee7f5;border:1rpx solid #e1d6eb;border-radius:23rpx;margin:22rpx 0 28rpx;padding:24rpx;line-height:1.3;color:#493363}.scan-symbol{width:60rpx;height:60rpx;border:4rpx solid #74558f;border-radius:13rpx;padding:10rpx;box-sizing:border-box;margin-right:20rpx}.scan-symbol view{height:100%;border-top:4rpx solid #74558f;border-bottom:4rpx solid #74558f}.scan-copy{flex:1}.scan-copy>view{font-size:32rpx;font-weight:650}.scan-copy text{display:block;font-size:21rpx;margin-top:8rpx;color:#877198}.scan-arrow{font-size:40rpx;margin-left:10rpx}.section-heading{display:flex;align-items:center;justify-content:space-between;font-size:28rpx;font-weight:650;color:#32273e;margin-bottom:18rpx}.section-note{font-size:20rpx;color:#aaa1b1;font-weight:400}.service-grid{display:grid;grid-template-columns:repeat(4,1fr);background:#fff;border:1rpx solid #eeeaf3;border-radius:23rpx;padding:24rpx 7rpx;gap:0}.service-grid button{background:transparent;padding:0;margin:0;color:#44364e;line-height:1.4;font-size:23rpx}.service-grid button>view:nth-child(2){font-weight:600}.service-grid button>text{display:block;font-size:18rpx;color:#a79baa;margin-top:7rpx}.service-grid .service-icon{font-size:36rpx;color:#785a91;margin-bottom:12rpx;line-height:1.2}
.attention{display:flex;align-items:center;gap:14rpx;padding:24rpx 7rpx;margin:3rpx 0 16rpx;border-bottom:1rpx solid #e9e4ee;color:#5b4a67;font-size:24rpx}.attention>view:nth-child(2){flex:1}.attention text{font-size:20rpx;color:#9c90a7;line-height:1.5;display:block;margin-top:7rpx}.attention>text{font-size:38rpx;margin-top:0}.attention-dot{height:12rpx;width:12rpx;background:#c4a06b;border-radius:50%;flex-shrink:0}.trend-panel,.review-panel,.announcement{padding:24rpx;background:white;border:1rpx solid #eeeaf3;border-radius:23rpx;margin-top:20rpx}.week-total{font-size:34rpx;color:#71548a}.week-total text{font-size:19rpx;font-weight:400}.trend-chart{display:flex;gap:18rpx;margin-top:10rpx}.trend-day{flex:1;text-align:center}.trend-column{height:100rpx;display:flex;align-items:flex-end;justify-content:center}.trend-column>view{width:36rpx;min-height:3rpx;border-radius:6rpx 6rpx 0 0;background:#b5a1c5}.trend-day>text{font-size:17rpx;color:#a89cab;display:block;margin-top:12rpx}.review-rating{font-size:23rpx;color:#a28356}.review-copy{font-size:25rpx;line-height:1.7;color:#716578}.review-author{font-size:20rpx;color:#aa9caf;margin-top:12rpx;display:block}.workbench-footer{text-align:center;color:#b4aab9;font-size:20rpx;margin-top:36rpx;letter-spacing:1rpx}.welcome-panel{background:#fff;border-radius:26rpx;padding:36rpx 28rpx;border:1rpx solid #e9e3ef}.welcome-title{font-size:31rpx;color:#4c375e;font-weight:600}.welcome-desc{font-size:25rpx;line-height:1.8;color:#97879f;margin:22rpx 0}.welcome-button{background:#655079;color:white;font-size:27rpx;border-radius:16rpx}.loading-panel,.error-panel{padding:40rpx 24rpx;background:#fff;border-radius:24rpx;color:#92839f;font-size:25rpx}.error-panel button{background:#eee7f5;color:#665178;font-size:24rpx;margin-top:20rpx}
