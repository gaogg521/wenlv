<merchant-nav id="merchant-navigation" title="游客的声音" />
<view class="page-heading"><view class="page-eyebrow">GUEST VOICE</view><view class="page-title">游客的声音</view><view class="page-caption">评价与游客笔记 · 内容由平台审核把关</view></view>
<view class="chips-bar"><view class="chip {{tab === 'reviews' ? 'on' : ''}}" bindtap="switchTab" data-k="reviews">评价</view><view class="chip {{tab === 'notes' ? 'on' : ''}}" bindtap="switchTab" data-k="notes">游客笔记</view></view>
<view wx:if="{{error}}" class="card"><ui-state kind="error" title="加载失败" desc="{{error}}" bind:retry="retry" /></view>
<view wx:elif="{{loading}}" class="card"><ui-state kind="loading" /></view>
<block wx:if="{{tab === 'reviews'}}">
  <view class="chips-bar">
    <view wx:for="{{replyFilters}}" wx:key="k" class="chip {{replyStatus === item.k ? 'on' : ''}}" bindtap="filterReply" data-k="{{item.k}}">{{item.n}}</view>
    <view wx:for="{{ratingFilters}}" wx:key="v" class="chip {{rating === item.v ? 'on' : ''}}" bindtap="filterRating" data-v="{{item.v}}">{{item.n}}</view>
  </view>
  <view wx:if="{{items.length}}" class="review-list">
    <view wx:for="{{items}}" wx:key="id" class="card review-card">
      <view class="rv-head"><text class="rv-stars">{{item.stars}}</text><text class="rv-state">{{item.replyStateText}}</text></view>
      <view class="rv-content">{{item.content}}</view>
      <view class="rv-meta">{{item.product_title}} · {{item.nickname}} · {{item.created_at}}<text wx:if="{{item.order_no}}" class="rv-no">单号 {{item.order_no}}</text></view>
      <view wx:if="{{item.reply}}" class="rv-reply {{item.reply_status === 2 ? 'off' : ''}}"><text class="rv-reply-tag">本店回复{{item.reply_status === 2 ? '（被下架）' : item.reply_status === 0 ? '（待审核）' : ''}}</text>{{item.reply}}</view>
      <view class="btn ghost sm" bindtap="reply" data-id="{{item.id}}">{{item.reply ? '修改回复' : '回复'}}</view>
    </view>
    <view wx:if="{{hasMore}}" class="btn ghost" bindtap="loadMore">加载更多</view>
    <view wx:else class="list-end">共 {{total}} 条评价</view>
  </view>
  <view wx:else class="card"><ui-state kind="empty" icon="💬" title="暂无符合条件的评价" desc="{{emptyDesc}}" /></view>
</block>
<block wx:else>
  <view wx:if="{{notes.length}}" class="review-list">
    <view wx:for="{{notes}}" wx:key="id" class="card review-card">
      <view class="nt-head"><text class="nt-title">{{item.title}}</text><text class="nt-date">{{item.published_at}}</text></view>
      <view class="nt-excerpt">{{item.excerpt}}</view>
      <view class="nt-meta">{{item.product_title}} · {{item.author}} · {{item.like_count}} 赞</view>
    </view>
    <view wx:if="{{hasMore}}" class="btn ghost" bindtap="loadMore">加载更多</view>
    <view wx:else class="list-end">共 {{notesTotal}} 篇笔记</view>
  </view>
  <view wx:else class="card"><ui-state kind="empty" icon="📓" title="还没有关于本店的游客笔记" desc="{{emptyNotesDesc}}" /></view>
</block>
