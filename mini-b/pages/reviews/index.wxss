/* X-04 评价列表页（复用全局体系，仅补本页布局） */
.chips-bar { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 0 24rpx 8rpx; }
.review-list { padding: 8rpx 24rpx 24rpx; }
.review-card { margin-bottom: 20rpx; }
.rv-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10rpx; }
.rv-stars { color: #d97706; font-size: 28rpx; letter-spacing: 4rpx; }
.rv-state { font-size: 22rpx; color: var(--muted, #8a919c); }
.rv-content { font-size: 28rpx; line-height: 1.6; color: var(--ink, #1f2a2e); }
.rv-meta { margin: 12rpx 0; font-size: 22rpx; color: var(--muted, #8a919c); display: flex; flex-wrap: wrap; gap: 8rpx; }
.rv-no { color: var(--muted, #8a919c); }
.rv-reply { background: var(--brand-soft, #f7f3ea); border-radius: 12rpx; padding: 14rpx 18rpx; font-size: 26rpx; line-height: 1.6; margin-bottom: 14rpx; }
.rv-reply.off { opacity: 0.55; }
.rv-reply-tag { display: block; font-size: 20rpx; color: var(--brand, #57704f); margin-bottom: 4rpx; }
.list-end { text-align: center; color: var(--muted, #8a919c); font-size: 22rpx; padding: 16rpx 0 8rpx; }
