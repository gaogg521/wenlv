.proof-acts{display:flex;gap:12rpx;flex:none}.honor-tabs{display:flex;background:#eee8d9;padding:7rpx;border-radius:15rpx;margin:20rpx 28rpx;gap:5rpx}.honor-tab{flex:1;text-align:center;font-size:25rpx;padding:17rpx 6rpx;color:#a09376;border-radius:11rpx}.honor-tab.active{background:#fffdf8;color:#60754d;box-shadow:0 2rpx 7rpx #5b50230a}.hn-crest{width:128rpx;height:128rpx;filter:none}.hn-hero{gap:26rpx}.tier-row{margin-bottom:14rpx;font-size:20rpx;color:#d2d6b9}.tier-name{font-size:24rpx;letter-spacing:2rpx;color:#e8d2ab}.hn-wall{grid-template-columns:repeat(3,1fr);margin:16rpx 28rpx 24rpx;gap:14rpx}.hn-b{border:1rpx solid #e8dfd1;box-shadow:none;border-radius:20rpx;padding:22rpx 5rpx 20rpx}.hn-b-img{width:128rpx;height:128rpx}.hn-b-n{font-size:23rpx;margin-top:13rpx}.hn-b-r{font-size:20rpx;margin-top:7rpx;color:#a89a81}.hn-seal{background:#edf4ef;border:0;color:#678b76;right:12rpx;top:12rpx}.hn-group{font-size:27rpx;color:#65764f;margin-top:28rpx}.hn-lv-ico{width:85rpx;height:85rpx}.hn-lv{padding:22rpx 0}.hn-lv-txt .tiny{font-size:21rpx;line-height:1.7}.hn-crit-t{font-size:23rpx;color:#93856d;line-height:1.6}.hn-bar{height:8rpx;background:#eee8d9}.hn-fill{background:#b5bb91}.trust-intro{margin:24rpx 28rpx;padding:26rpx;display:flex;gap:20rpx;background:#e9eedf;border-radius:23rpx;color:#62764f;font-size:27rpx;line-height:1.5}.trust-symbol{font-size:50rpx;color:#ac8959}.trust-intro text{display:block;font-size:21rpx;color:#969474;margin-top:9rpx}.proof-paper{margin:18rpx 28rpx;background:#fffdf8;border:1rpx solid #e8dfd1;border-radius:24rpx;padding:24rpx}.proof-top{display:flex;gap:16rpx;align-items:center}.proof-top image{width:75rpx;height:75rpx;flex-shrink:0}.proof-title{flex:1;min-width:0;font-size:26rpx;color:#566846;line-height:1.5}.proof-title text{font-size:20rpx;color:#a7997e}.proof-top .status-label{font-size:18rpx;max-width:160rpx;text-align:center}.proof-code{margin-top:20rpx;padding-top:20rpx;border-top:1rpx dashed #e6dcc6;display:flex;justify-content: