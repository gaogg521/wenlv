.honor-tabs{display:flex;background:#ede6f3;padding:7rpx;border-radius:15rpx;margin:20rpx 28rpx;gap:5rpx}.honor-tab{flex:1;text-align:center;font-size:25rpx;padding:17rpx 6rpx;color:#9d86ae;border-radius:11rpx}.honor-tab.active{background:#fff;color:#715184;box-shadow:0 2rpx 7rpx #50325b0a}.hn-crest{width:128rpx;height:128rpx;filter:none}.hn-hero{gap:26rpx}.tier-row{margin-bottom:14rpx;font-size:20rpx;color:#d8c6e5}.tier-name{font-size:24rpx;letter-spacing:2rpx;color:#e8d2ab}.hn-wall{grid-template-columns:repeat(3,1fr);margin:16rpx 28rpx 24rpx;gap:14rpx}.hn-b{border:1rpx solid #ebe5f0;box-shadow:none;border-radius:20rpx;padding:22rpx 5rpx 20rpx}.hn-b-img{width:128rpx;height:128rpx}.hn-b-n{font-size:23rpx;margin-top:13rpx}.hn-b-r{font-size:20rpx;margin-top:7rpx;color:#ab9ab3}.hn-seal{background:#edf4ef;border:0;color:#678b76;right:12rpx;top:12rpx}.hn-group{font-size:27rpx;color:#61496f;margin-top:28rpx}.hn-lv-ico{width:85rpx;height:85rpx}.hn-lv{padding:22rpx 0}.hn-lv-txt .tiny{font-size:21rpx;line-height:1.7}.hn-crit-t{font-size:23rpx;color:#8a7897;line-height:1.6}.hn-bar{height:8rpx;background:#f0eaf5}.hn-fill{background:#ac92be}.trust-intro{margin:24rpx 28rpx;padding:26rpx;display:flex;gap:20rpx;background:#ede7f3;border-radius:23rpx;color:#715381;font-size:27rpx;line-height:1.5}.trust-symbol{font-size:50rpx;color:#a486b5}.trust-intro text{display:block;font-size:21rpx;color:#a08aab;margin-top:9rpx}.proof-paper{margin:18rpx 28rpx;background:#fff;border:1rpx solid #eae5ef;border-radius:24rpx;padding:24rpx}.proof-top{display:flex;gap:16rpx;align-items:center}.proof-top image{width:75rpx;height:75rpx;flex-shrink:0}.proof-title{flex:1;min-width:0;font-size:26rpx;color:#62486e;line-height:1.5}.proof-title text{font-size:20rpx;color:#af9bb5}.proof-top .status-label{font-size:18rpx;max-width:160rpx;text-align:center}.proof-code{margin-top:20rpx;padding-top:20rpx;border-top:1rpx dashed #e9e0f0;display:flex;justify-content:space-between;align-items:center}.proof-code text{font-size:19rpx;color:#b09eb9}.proof-code view>view{font-size:28rpx;color:#9a80a7;letter-spacing:4rpx;font-family:monospace;margin-top:7rpx}.proof-code button{margin:0}
