.page { min-height: 100vh; background: #f6f7fb; padding: 0 24rpx 48rpx; }
.hero { padding: 36rpx 8rpx 20rpx; }
.hero-title { font-size: 40rpx; font-weight: 700; color: #1c2333; }
.hero-sub { margin-top: 10rpx; font-size: 24rpx; color: #7b849b; line-height: 1.6; }
.tabs { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.tab { padding: 10rpx 26rpx; border-radius: 999rpx; background: #fff; color: #5a6377; font-size: 26rpx; border: 1rpx solid #e4e8f0; }
.tab.on { background: #2953ff; color: #fff; border-color: #2953ff; }
.card { background: #fff; border-radius: 20rpx; padding: 24rpx; margin-bottom: 18rpx; box-shadow: 0 2rpx 10rpx rgba(28,35,51,.05); }
.row-top { display: flex; justify-content: space-between; align-items: center; }
.req-no { font-size: 28rpx; font-weight: 600; color: #1c2333; }
.status { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 999rpx; }
.status.s1 { background: #fff4dc; color: #9a6a00; }
.status.s3 { background: #fde3e1; color: #b42318; }
.status.s4 { background: #e1f7ec; color: #0f7b3f; }
.status.s0, .status.s2 { background: #eef1f6; color: #7b849b; }
.line { margin-top: 12rpx; font-size: 28rpx; color: #343d52; }
.sub { margin-top: 8rpx; font-size: 24rpx; color: #8b93a7; }
.sub.warn { color: #b42318; }
.btns { display: flex; gap: 14rpx; margin-top: 16rpx; }
.btn { padding: 12rpx 30rpx; border-radius: 12rpx; font-size: 26rpx; text-align: center; }
.btn.ghost { border: 1rpx solid #d6dbe6; color: #5a6377; background: #fff; }
.empty { padding: 80rpx 0; text-align: center; color: #9aa2b5; font-size: 26rpx; }
