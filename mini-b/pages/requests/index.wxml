<view class="page">
  <view class="hero">
    <view class="hero-title">我的变更申请</view>
    <view class="hero-sub">改价、名额、停售、恢复与早鸟调整统一走「提交审核 → 平台确认 → 生效」;批准前游客端继续按原版本展示与下单。</view>
  </view>
  <view class="tabs">
    <view class="tab {{tab === 'all' ? 'on' : ''}}" data-k="all" bindtap="setTab">全部</view>
    <view class="tab {{tab === '1' ? 'on' : ''}}" data-k="1" bindtap="setTab">待审核</view>
    <view class="tab {{tab === '3' ? 'on' : ''}}" data-k="3" bindtap="setTab">已退回</view>
    <view class="tab {{tab === '4' ? 'on' : ''}}" data-k="4" bindtap="setTab">已生效</view>
  </view>
  <view class="tabs" wx:if="{{canCreateProduct}}"><view class="tab on" bindtap="goCreate">＋ 新增商品申请</view></view>
  <view wx:if="{{error}}" class="empty">{{error}}</view>
  <view wx:if="{{loaded && !list.length && !error}}" class="empty">暂无申请记录;在「库存」页发起的调整会出现在这里</view>
  <view wx:for="{{list}}" wx:key="id" class="card">
    <view class="row-top">
      <view class="req-no">{{item.req_no}}</view>
      <view class="status s{{item.status}}">{{item.statusText}}</view>
    </view>
    <view class="line">{{item.kindText}} · {{item.action === 'create' ? '新增' : '修改'}} {{item.changeText}}</view>
    <view wx:if="{{item.impact_note}}" class="sub">影响:{{item.impact_note}}</view>
    <view wx:if="{{item.resultText}}" class="sub warn">{{item.resultText}}</view>
    <view class="sub">提交时间:{{item.timeText}}{{item.channel === 'mini' ? ' · 小程序' : ' · PC 后台'}}</view>
    <view class="btns">
      <view wx:if="{{item.canEditDraft}}" class="btn ghost" data-id="{{item.id}}" bindtap="editDraft">继续编辑</view>
      <view wx:if="{{item.canWithdraw}}" class="btn ghost" data-id="{{item.id}}" bindtap="withdraw">撤回</view>
      <view wx:if="{{item.canRedo}}" class="btn ghost" data-id="{{item.id}}" bindtap="redo">重新发起</view>
    </view>
  </view>
</view>
