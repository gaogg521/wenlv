<merchant-nav id="merchant-navigation" title="扫码核销" />
<!-- 离线模式黄条：队列待上传 / 名单同步时间 -->
<view wx:if="{{offline.pending > 0}}" style="background:#fff8e6;border:1.5rpx solid #f0c674;color:#8a6d1a;border-radius:18rpx;padding:18rpx 24rpx;font-size:24rpx;margin-bottom:16rpx;display:flex;align-items:center;gap:16rpx">
  <view style="flex:1">⚠️ 离线队列 {{offline.pending}} 条待上传 · 名单同步于 {{offline.syncedAt}}</view>
  <view bindtap="uploadQueue" style="background:#8a6d1a;color:#fff;border-radius:14rpx;padding:8rpx 20rpx">上传</view>
</view>
<view wx:elif="{{offline.listReady}}" style="background:#f4f9f4;border:1.5rpx solid #cfe3cf;color:#3f6f3f;border-radius:18rpx;padding:14rpx 24rpx;font-size:22rpx;margin-bottom:16rpx">
  ✓ 离线名单已就绪（同步于 {{offline.syncedAt}}）· 断网可记录待复核凭证，恢复后上传
</view>
<view class="card fade-up" wx:if="{{result}}" style="background:{{result.ok ? '#f0faf7' : '#fdf2f2'}}">
  <view class="row">
    <view><b style="color:{{result.ok ? 'var(--green)' : 'var(--red)'}}">{{result.pending ? '待联网复核' : result.reason}}</b>
      <view class="sub">{{result.pending ? '联网复核后更新订单状态' : '本次核销结果已更新'}}</view></view>
    <view class="v tiny">#{{result.passId || result.payload}}</view>
  </view>
</view>
<view class="scan-box">
  <view class="scan-frame">
    <view class="corner c1"></view><view class="corner c2"></view>
    <view class="corner c3"></view><view class="corner c4"></view>
    <view class="beam"></view>
    <view class="mid">🎫</view>
  </view>
  <view style="margin-top:32rpx;font-size:26rpx">对准游客「入园核销码」</view>
  <view style="font-size:22rpx;opacity:.7;margin-top:8rpx">支持连续扫码 · 一码一次有效 · 异常自动拦截</view>
</view>
<view class="btn" bindtap="scan">📷 打开相机扫码</view>
<view class="btn ghost" style="margin-top:16rpx" bindtap="phraseInput">🎭 剧本游 · 对暗号核销</view>
<!-- B03 套餐服务项履约：本店待履约清单，逐项核销（幂等） -->
<view class="card fade-up" wx:if="{{svcItems.length}}">
  <view class="sec-title">套餐服务项 · 待履约（{{svcItems.length}}）</view>
  <view wx:for="{{svcItems}}" wx:key="id" style="display:flex;align-items:center;gap:16rpx;padding:16rpx 0;border-bottom:1rpx solid var(--line)">
    <view style="flex:1;min-width:0">
      <view style="font-weight:600">{{item.name}} <text class="tiny">×{{item.qty}}</text></view>
      <view class="tiny">{{item.product_title || ''}} · {{item.order_no}} · {{item.contact_name || ''}}</view><view class="tiny" wx:if="{{item.benefit_desc}}" style="color:#7b5aa6">{{item.benefit_desc}}</view>
    </view>
    <view class="btn sm" style="padding:14rpx 30rpx" data-i="{{index}}" bindtap="redeemSvc">完成履约</view>
  </view>
</view>
<view class="card fade-up">
  <view class="sec-title">手动输码</view>
  <view class="tiny" style="margin-bottom:16rpx">屏幕破损/码被遮挡时：输入游客展示的 6 位数字</view>
  <view style="display:flex;gap:16rpx">
    <input value="{{input}}" bindinput="onInput" type="number" maxlength="6" placeholder="— — — — — —"
      style="flex:1;border:1.5rpx solid var(--line);border-radius:18rpx;padding:18rpx 26rpx;font-size:32rpx;letter-spacing:8rpx;text-align:center;font-weight:600" />
    <view class="btn sm" style="padding:18rpx 44rpx;font-size:28rpx" bindtap="submit">核销</view>
  </view>
</view>
<view class="note">离线核销仅限名单内凭证 · 恢复网络后二次校验，冲突转人工队列</view>
<view class="note" wx:if="{{streak > 0}}" style="color:var(--brand);font-weight:600">🔥 连续核销 {{streak}} 单 · 800ms 自动进入下一单</view>
