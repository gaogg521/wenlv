r-radius:12rpx;border:1rpx solid #e4d8ed;background:#f5eff9;color:#80618f;width:auto;min-width:0;box-sizing:border-box}.compact-button::after{border:0}.status-label{display:inline-block;font-size:20rpx;color:#9c90a5;background:#f3eff6;padding:5rpx 13rpx;border-radius:7rpx}.status-label.positive{color:#678475;background:#edf3ef}.paper-metrics{display:flex;margin:22rpx 28rpx;padding:26rpx;background:#fff;border:1rpx solid #eae5ef;border-radius:24rpx;gap:16rpx}.paper-metrics>view{flex:1;min-width:0}.paper-number{font-size:35rpx;color:#674b79;font-weight:600;display:block}.paper-label{font-size:21rpx;color:#a191ad;display:block;margin-top:9rpx}
