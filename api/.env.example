# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=wanderlust

# ===== 安全（上产必改）=====
JWT_SECRET=change-me-to-a-long-random-string
PASS_SECRET=change-me-pass-code-secret
ADMIN_INIT_PASSWORD=change-admin-password

# ===== 微信小程序（填入即接真实登录；也可在管理后台「集成中心」配置）=====
WX_APPID=
WX_SECRET=
# 商户小程序必须使用独立、有效的 AppID / Secret
WX_B_APPID=
WX_B_SECRET=
# 订阅消息模板 ID（公众平台→订阅消息→我的模板；后台集成中心可配，.env 仅兜底）
WX_TMPL_PAY_OK=

# ===== 微信支付 V3（当前为普通商户 JSAPI；真实通道仍需实际验收）=====
WX_MCHID=
WX_SERIAL=
WX_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WX_PLATFORM_PUBLIC_KEY=./certs/wxpay_pub.pem
WX_PLATFORM_SERIAL=
WX_API_V3_KEY=
WX_NOTIFY_URL=https://your-domain.com/callback/wxpay

PORT=8080

# 生产环境强制拒绝未配置微信凭据及联调操作
NODE_ENV=development
# 当前结算模式：实际支付后由财务登记回单；未实现电商收付通自动分账

# ===== 链数根存证（真实上链）=====
# 三项齐备 → chainMode=real，新批次真实锚定；缺任一项 → NOOP，批次停在「已打包·待锚定」
# 自检：node scripts/chain-ready.mjs（加 --probe 试锚一枚测试根，加 --anchor 补锚全部待锚批次）
CHAIN_ENDPOINT=
CHAIN_ACCOUNT=
CHAIN_KEY=
# 对外可访问基址（写进存证报告二维码）；不填则按请求头 Host 推断
PUBLIC_BASE=

# ===== 多链选择（一套契约 N 个适配器；改这一行即换链，业务代码零改动）=====
# chaingen=链数根 / tbaas=腾讯云TBaaS / antchain=蚂蚁链鲸探 / evm=Polygon等 / noop=未接入 / mock=自测(仅非生产)
# 留空则按下面已有凭据自动推断
CHAIN_PROVIDER=
# 支持资产发行的链：tbaas / antchain / evm（chaingen 联盟链只做存证）
# 微信渠道在代码与库层双双硬禁（D10），不要试图配
#
# ★ 四家链的「填空式模板」在 api/config/chains/ 目录（中文文件名，含怎么申请/问对方什么）：
#    链数根.env · 腾讯TBaaS.env · 蚂蚁链鲸探.env · EVM公链.env
# ★ 预埋体检（离线、不需要凭据）：node scripts/chain-preflight.mjs [chaingen|tbaas|antchain|evm]

# --- 腾讯云 TBaaS / 至信链（需先部署落根合约）---
TBAAS_SECRET_ID=
TBAAS_SECRET_KEY=
TBAAS_CLUSTER_ID=
TBAAS_CHANNEL=
TBAAS_ENDPOINT=https://tbaas.tencentcloudapi.com
TBAAS_REGION=ap-shanghai
TBAAS_ACTION=Invoke
TBAAS_VERSION=2020-04-17
TBAAS_ROOT_FUNC=writeRoot
TBAAS_MINT_FUNC=
TBAAS_NFT_CONTRACT=

# --- 蚂蚁链 AntChain / 鲸探（藏品需资质+内容审核+服务商接入）---
ANTCHAIN_ENDPOINT=
ANTCHAIN_ACCESS_KEY=
ANTCHAIN_ACCESS_SECRET=
ANTCHAIN_PRIVATE_KEY=
ANTCHAIN_SIGN=hmac-sha256
ANTCHAIN_BIZID=
ANTCHAIN_ACCOUNT=
ANTCHAIN_VERSION=1.0
ANTCHAIN_ROOT_PATH=/v1/attest/anchor
ANTCHAIN_ASSET_PATH=/v1/asset/issue
ANTCHAIN_COLLECTION_ID=

# --- 通用 EVM（私钥不进本服务，由 relayer/KMS 托管签名）---
EVM_RELAYER_URL=
EVM_RELAYER_TOKEN=
EVM_RPC_URL=
EVM_ANCHOR_TO=
EVM_CHAIN_ID=
EVM_NFT_CONTRACT=
EVM_MINT_SIGNATURE=mint(address,uint256,uint256,bytes)
EVM_EXPLORER=

# ===== 风控告警外推（V21）=====
# 严重告警（severity>=2 未处理）推送到 webhook；留空=只落库不推送
# ALERT_WEBHOOK_MODE: wecom=企业微信群机器人（默认） / raw=原始JSON（飞书等自行适配）
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_MODE=wecom
