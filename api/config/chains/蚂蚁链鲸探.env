# ============================================================================
# 蚂蚁链 AntChain / 鲸探数字藏品 —— 预埋模板
#
# 用法：复制「配置区」到 wanderlust/api/.env → 填值 → 重启 → 自检。
# 自检：node scripts/chain-preflight.mjs antchain   （离线：签名与请求头齐备性）
#      node scripts/chain-ready.mjs --probe         （有凭据后试锚）
#
# 现状：HMAC / RSA 两种签名都预埋好，请求头齐全；缺凭据 + BizID +（发藏品时）CollectionId。
# ⚠️ 鲸探藏品是「资质 + 内容审核 + 服务商接入」三件事，不是纯技术对接，周期以周计。
# ============================================================================

# ---------------- 配置区（存证最小集）----------------
CHAIN_PROVIDER=antchain
ANTCHAIN_ENDPOINT=          # 开放平台网关，例 https://openapi.antchain.antgroup.com
ANTCHAIN_ACCESS_KEY=        # AccessKey（开放平台 → 我的应用）
ANTCHAIN_ACCESS_SECRET=     # AccessSecret（hmac 模式必填）
ANTCHAIN_BIZID=             # 业务 ID / 链 ID（BizId 或 ChainId，以对方文档为准）

# --- 签名方式：hmac-sha256（默认）或 rsa-sha256（需配私钥 PEM）---
ANTCHAIN_SIGN=hmac-sha256
ANTCHAIN_PRIVATE_KEY=       # 仅 rsa-sha256 模式：PEM 内容（换行用 \n 或引号包多行）

# --- 可选：接口路径与账户（不同 OpenAPI 版本路径会变，按对方文档改这两行即可）---
ANTCHAIN_ROOT_PATH=/v1/attest/anchor
ANTCHAIN_ASSET_PATH=/v1/asset/issue
ANTCHAIN_ACCOUNT=           # 平台在链上的账户地址/标识（发行时的默认接收方）

# --- 要发藏品/徽章才需要 ---
ANTCHAIN_COLLECTION_ID=     # 数字资产集合 ID（鲸探/数字资产服务里申请，需资质审核）

# ---------------- 怎么开通 ----------------
# 1. 蚂蚁链开放平台注册 → 创建应用 → 拿到 AccessKey/AccessSecret/BizId（先要测试环境）
# 2. 存证：确认是「写合约」还是「用存证服务」；写合约需部署合约（我方给方法规格）
# 3. 藏品：申请数字资产服务 → 提交资质（文网文/ICP/主体资质视业务而定）→ 内容审核 → 服务商接入
#    → 开通集合（CollectionId）→ 才能发行
#
# ---------------- 预埋的接口约定 ----------------
# 落根    POST {ANTCHAIN_ENDPOINT}{ANTCHAIN_ROOT_PATH}
#         请求 {root, prevRoot, leafCount, bizDate, kind}
#         响应 {txHash | txRef | transactionHash, blockNumber}
# 发行    POST {ANTCHAIN_ENDPOINT}{ANTCHAIN_ASSET_PATH}
#         请求 {collectionId, to, tokenId, uri, meta}
#         响应 {txHash, tokenId}
# 签名头  x-acs-signature-method / x-acs-signature-nonce / x-acs-version /
#         x-acs-accesskey / x-acs-timestamp / x-acs-signature / x-acs-bizid
#         签名串 METHOD\nPATH\nts\nbody
#
# ---------------- 对接时必须问对方的 4 个问题 ----------------
# · OpenAPI 版本与签名方式（hmac / rsa），签名字段名以哪份文档为准？有没有 nonce 校验？
# · 存证是写合约还是走存证服务？接口路径与参数名？
# · 鲸探藏品：资质、内容审核、服务商接入的办理顺序与周期？可否先上测试集合？
# · CollectionId 如何申请？单次/批量发行上限、审核时长、是否支持销毁/转赠限制？
#
# ---------------- 能力边界 ----------------
# ✅ 存证锚定 · 资产发行（资质齐备后）· DID
# ⚠️ 微信渠道硬禁：藏品**不得**在小程序内引导购买/交易（代码层 + 库层双闸门，勿试图绕过）
