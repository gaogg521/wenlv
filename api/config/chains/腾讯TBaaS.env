# ============================================================================
# 腾讯云 TBaaS / 至信链 —— 预埋模板
#
# 用法：复制「配置区」到 wanderlust/api/.env → 填值 → 重启 → 自检。
# 自检：node scripts/chain-preflight.mjs tbaas      （离线：TC3 签名可算出且确定性）
#      node scripts/chain-ready.mjs --probe        （有凭据后试锚）
#
# 现状：TC3-HMAC-SHA256 签名已按腾讯云规范实现并通过离线自测；
#      缺的是 SecretId/SecretKey + 集群/通道，以及一枚「落根合约」。
# ============================================================================

# ---------------- 配置区 ----------------
CHAIN_PROVIDER=tbaas
TBAAS_SECRET_ID=           # 腾讯云 API 密钥 SecretId（访问管理 CAM → API 密钥管理）
TBAAS_SECRET_KEY=          # 对应 SecretKey
TBAAS_CLUSTER_ID=          # TBaaS 区块链集群 ID（控制台「区块链」→ 集群详情）
TBAAS_CHANNEL=             # 通道 ID（联盟链通道名）

# --- 以下有默认值，通常不用改 ---
TBAAS_ENDPOINT=https://tbaas.tencentcloudapi.com   # 私有化/专属网关时换成对方给的地址
TBAAS_REGION=ap-shanghai
TBAAS_ACTION=Invoke        # TBaaS 合约调用 Action；不同版本可能不同
TBAAS_VERSION=2020-04-17
TBAAS_ROOT_FUNC=writeRoot  # 落根合约方法名：writeRoot(bytes32 root, bytes32 prevRoot, uint64 bizDate)
# --- 要发数字徽章/权益凭证 NFT 才需要填 ---
TBAAS_MINT_FUNC=           # 发行方法名，例 mint
TBAAS_NFT_CONTRACT=        # NFT / ERC-1155 合约名或地址

# ---------------- 怎么开通 ----------------
# 1. 腾讯云控制台 → 区块链 TBaaS → 创建/加入集群（联盟链需邀请方审批）
# 2. 在集群里创建通道 → 部署「落根合约」（我方给 ABI 规格，见下）
# 3. CAM 里建子账号，只授 tbaas:Invoke 权限，生成 SecretId/SecretKey（最小权限，勿用主账号密钥）
# 4. 要发资产再部署 ERC-1155 合约并把 mint 权限授予平台账户
#
# ---------------- 落根合约规格（可直接发给对方技术）----------------
# 方法：writeRoot(bytes32 root, bytes32 prevRoot, uint64 bizDate)
# 我方调用参数：FuncName=writeRoot, FuncParam=["<64位hex root>", "<64位hex prevRoot 或 64个0>", <yyyyMMdd 数字>]
# 响应要求：必须返回交易号（Txid），我方以其为 txRef
#
# ---------------- 对接时必须问对方的 4 个问题 ----------------
# · 落根合约谁来部署？我方给 ABI 规格可以吗？
# · 合约方法名与参数顺序是否就是 writeRoot(bytes32,bytes32,uint64)？
# · Action/Version/Region 是否就是 Invoke / 2020-04-17 / ap-shanghai？私有化网关地址给一下。
# · NFT 发行方法名与合约（mint / safeMint / ERC-1155 mint），calldata 我方按 ABI 生成。
#
# ---------------- 能力边界 ----------------
# ✅ 存证锚定 · 资产发行（部署了 NFT 合约）    ⚠️ 无「按根反查」标准接口 → 幂等靠本地台账 + Txid
# ❌ DID 派生（本平台自带 DID 层，不依赖 TBaaS）
