.pass-row { display: flex; align-items: center; gap: 16rpx; padding: 22rpx 0; border-bottom: 1rpx solid var(--line); }
.pass-row:last-child { border-bottom: none; }
.p-name { font-weight: 600; font-size: 28rpx; }
.p-st { font-size: 22rpx; color: var(--sub); margin-top: 4rpx; }
.p-btn { font-size: 24rpx; color: #fff; background: var(--brand); border-radius: 999rpx; padding: 10rpx 24rpx; }
.st-tag { margin-left: 18rpx; font-size: 24rpx; background: rgba(255,255,255,.22); border-radius: 999rpx; padding: 6rpx 20rpx; vertical-align: middle; }
.tl-item { position: relative; padding: 0 0 22rpx 28rpx; }
.tl-item::before { content: ""; position: absolute; left: 5rpx; top: 10rpx; width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--brand); box-shadow: 0 0 0 4rpx var(--brand-soft); }
.tl-item::after { content: ""; position: absolute; left: 10rpx; top: 28rpx; bottom: 0; width: 2rpx; background: var(--line); }
.tl-item:last-child::after { display: none; }
.tl-item .t { font-weight: 600; font-size: 26rpx; }
.tl-item .d { font-size: 22rpx; color: var(--sub); }
.tl-item .d:first-of-type { margin-left: 10rpx; font-weight: 400; }
