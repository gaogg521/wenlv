.code-hero { background: linear-gradient(160deg, var(--brand), #f5a623); padding: 40rpx 32rpx 88rpx; border-radius: 0 0 48rpx 48rpx; text-align: center; color: #fff; }
.code-tip { font-size: 24rpx; opacity: .92; margin-bottom: 28rpx; }
.qr-box { width: 420rpx; height: 420rpx; margin: 0 auto; background: #fff; border-radius: 24rpx; position: relative; overflow: hidden; padding: 20rpx; }
.qr-grid { display: grid; grid-template-columns: repeat(15, 1fr); grid-template-rows: repeat(15, 1fr); width: 100%; height: 100%; gap: 0; }
.qr-cell { background: transparent; border-radius: 0; }
.qr-cell.on { background: #000; }
.qr-scanline { position: absolute; left: 12rpx; right: 12rpx; height: 4rpx; border-radius: 4rpx;
  background: linear-gradient(90deg, transparent, var(--brand), transparent); opacity: .85; animation: scan 2.4s ease-in-out infinite; }
@keyframes scan { 0%, 100% { top: 24rpx; } 50% { top: 392rpx; } }
.display-code { font-size: 64rpx; font-weight: 800; letter-spacing: 18rpx; margin: 30rpx 0 6rpx; text-shadow: 0 2rpx 10rpx rgba(0,0,0,.15); }
.code-sub { font-size: 22rpx; opacity: .85; }
.ring { width: 84rpx; height: 84rpx; border-radius: 50%; margin: 26rpx auto 0; display: flex; align-items: center; justify-content: center; }
.ring-in { width: 62rpx; height: 62rpx; border-radius: 50%; background: rgba(0,0,0,.18); display: flex; align-items: center; justify-content: center; font-size: 20rpx; font-weight: 700; }
