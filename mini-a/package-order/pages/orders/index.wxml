<view wx:if="{{error}}" class="card"><view>{{error}}</view><view class="btn ghost" bindtap="fetch">重新加载</view></view>
<view wx:if="{{loading}}"><view class="skeleton" wx:for="{{[1,2]}}" wx:key="*this"></view></view>
<view wx:elif="{{empty}}" class="empty"><view class="e-ico">🧾</view>还没有订单，去首页看看线路吧</view>
<block wx:else>
  <view class="tour-item fade-up" wx:for="{{orders}}" wx:key="order_no" bindtap="goDetail" data-no="{{item.order_no}}">
    <view class="tour-cover cover-{{index % 5}}" style="font-size:52rpx">🎫</view>
    <view style="flex:1;min-width:0">
      <view style="display:flex;align-items:center;gap:12rpx">
        <view class="tour-title" style="flex:1">{{item.title}}</view>
        <view class="tag {{item.status >= 50 ? '' : 'blue'}}" style="margin:0;flex-shrink:0">{{item.statusText}}</view>
      </view>
      <view class="muted2" style="font-size:20rpx">{{item.order_no}}</view>
      <view class="tour-desc">{{item.days_desc}} · {{item.qty}} 人 · {{item.created_at}}</view>
      <view style="display:flex;align-items:center;justify-content:space-between">
        <view class="tour-price" style="margin:0"><text class="rmb">¥</text>{{item.amount_pay / 100}}</view>
        <text wx:if="{{item.status === 30}}" class="tag" style="margin:0">出示核销码 ›</text>
      </view>
    </view>
  </view>
</block>
<view class="note">点订单看进度时间线 · 待出行订单可出示核销码</view>
