<view class="hero"><view class="hi">合作中心</view><view class="sub2">按授权主体查询项目与分润 · 门店岗位独立授权</view></view>
<view wx:if="{{error}}" class="card"><view>{{error}}</view><button bindtap="load">重试</button></view>
<view class="card" wx:if="{{loading}}">正在核对授权…</view>
<view class="card" wx:if="{{!subjects.length && !error && !loading}}">暂无有效合作授权，请联系平台运营。</view>
<view class="card" wx:for="{{subjects}}" wx:key="id" data-id="{{item.id}}" bindtap="choose"><view>{{item.name}}</view><view class="note">查看此主体</view></view>
<view class="card" wx:if="{{current}}"><view class="sec-title">当前主体：{{current.name}}</view><view class="kv" wx:for="{{resources}}" wx:key="id"><text>{{item.label}}</text><text>{{item.name}}</text></view><view class="note">{{note}}</view></view>
<view class="card" wx:if="{{current}}"><view class="kv"><picker mode="date" bindchange="queryInput" data-field="from"><text>{{from || '分润开始日期'}}</text></picker><picker mode="date" bindchange="queryInput" data-field="to"><text>{{to || '截止日期'}}</text></picker></view><input type="number" value="{{productId}}" placeholder="分润产品编号（留空全部）" bindinput="queryInput" data-field="productId"/><button bindtap="applyQuery">按条件查询</button></view>
<view class="card" wx:if="{{projects.length}}"><view class="sec-title">关联项目与当前合同</view><view wx:for="{{projects}}" wx:key="id"><view class="kv"><text>{{item.title}} #{{item.id}}</text><text>{{item.status === 1 ? '在售' : '已停售'}}</text></view><view wx:for="{{item.contracts}}" wx:for-item="c" wx:key="id"><view>{{c.roleText}} · {{c.status === 1 ? '合作生效' : '合作停用'}} · 登记投入 ¥{{c.investText}}</view><view>当前分润比例 {{c.shareText}} · 协议 {{c.contractNo || '未登记'}}</view><view>协议 {{c.from || '待核实'}} — {{c.to || '待核实'}}</view><view>收款尾号 {{c.payoutTail || '未登记'}} · 请联系平台核实变更</view><view class="note">{{c.note}}</view></view></view></view>
<view class="card" wx:for="{{profits}}" wx:key="id"><view>{{item.title}} · {{item.period}}</view><view>留存分配基数 ¥{{item.baseText}} · 比例 {{item.shareText}}</view><view>规则版本 {{item.version}} · 来源结算 #{{item.settlement_id}}</view><view>应付 ¥{{item.amountText}} · 已登记支付 ¥{{item.paidText}}</view><view>待付 ¥{{item.pendingText}} · 有效冲正 ¥{{item.adjustText}}</view><view>{{item.statusText}}</view><button data-id="{{item.id}}" bindtap="loadPayments">查看付款及回单</button><button data-id="{{item.id}}" bindtap="sendFeedback">发起对账反馈</button></view>
<view class="card" wx:for="{{payments}}" wx:key="id"><view>{{item.direction === 2 ? '冲正' : '付款'}} ¥{{item.amountText}} · {{item.statusText}}</view><view>{{item.pay_date}} · {{item.pay_ref}}</view><view>{{item.note}}</view><button wx:if="{{item.hasReceipt}}" bindtap="receipt" data-id="{{item.id}}">查看回单</button></view>
<view class="card" wx:if="{{current}}"><view wx:if="{{!profits.length}}">暂无本主体分润记录</view><view class="kv"><button wx:if="{{page>1}}" bindtap="prev">上一页</button><text>第{{page}}页 · 分润{{total}}条</text><button wx:if="{{hasNext}}" bindtap="next">下一页</button></view></view>
<view class="card" wx:for="{{feedback}}" wx:key="id"><view>核对 #{{item.id}}：{{item.detail}}</view><view class="note">{{item.replyText}}</view></view>
