<view class="hero"><view class="hi">可推广产品</view><view class="sub2">人员授权与实时售价 · 首触归因</view></view>
<view class="card" wx:if="{{loading && !rows.length}}"><ui-state kind="loading" /></view>
<ui-state wx:if="{{qual === 'denied'}}" kind="denied" title="推广资格未生效或已暂停" icon="🧭"
  reasons="{{deniedReasons}}"
  action-text="联系平台客服咨询" action-open="contact"
  secondary-text="返回推广中心" secondary-url="/package-promo/pages/center/index" />
<ui-state wx:if="{{error}}" kind="error" title="产品列表加载失败" desc="{{error}}" bind:retry="retry" />
<view class="card" wx:if="{{!rows.length && !error && !loading && qual !== 'denied'}}">
  <ui-state kind="empty" icon="🧭" title="暂无可推广的产品" compact
    desc="{{emptyDesc}}"
    action-text="返回推广中心" action-url="/package-promo/pages/center/index" />
</view>
<view class="card fade-up" wx:for="{{rows}}" wx:key="id">
  <image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" class="wk-cover"/>
  <view class="sec-title">{{item.title}}</view>
  <view class="kv"><text>当前费率</text><text>{{item.rateText}}</text></view>
  <view class="note">授权 {{item.valid_from}} — {{item.valid_to}}</view>
  <view wx:for="{{item.sessions}}" wx:for-item="s" wx:key="id" class="kv"><text>{{s.depart_date}} · ¥{{s.priceText}}</text><text>余 {{s.left_seats}}</text></view>
  <view wx:if="{{!item.sessions.length}}" class="note">近期无可售团期</view>
  <button class="btn primary sm" bindtap="makeMaterial" data-id="{{item.id}}">获取推广素材</button>
</view>
<view class="chips"><button wx:if="{{page>1}}" class="btn ghost sm" bindtap="prev">上一页</button><text class="muted">第{{page}}页 · {{total}}项</text><button wx:if="{{hasNext}}" class="btn ghost sm" bindtap="next">下一页</button></view>
<view class="card fade-up" wx:if="{{material}}">
  <view class="sec-title">{{material.title}}</view>
  <view>{{material.text}}</view>
  <view class="note">{{material.note}}</view>
  <image wx:if="{{qrcode}}" src="{{qrcode}}" mode="aspectFit" class="wk-qr"/>
  <view class="wk-actions"><button class="btn primary sm" open-type="share">分享给好友</button><button class="btn ghost sm" bindtap="copy">复制转发文案</button></view>
  <button wx:if="{{qrcode}}" class="btn ghost sm" bindtap="makePoster">制作产品海报</button>
  <image wx:if="{{poster}}" src="{{poster}}" mode="widthFix" style="width:100%;border-radius:16rpx;margin-top:16rpx"/>
  <button wx:if="{{poster}}" class="btn primary sm" bindtap="save">保存海报到相册</button>
</view>
<canvas canvas-id="poster" style="position:fixed;left:-2000px;width:600px;height:800px"/>
