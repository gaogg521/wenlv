<view class="hero"><view class="hi">旅行笔记广场</view><view class="sub2">看看大家去了哪 · 点赞支持创作者</view></view>
<view wx:if="{{error}}" class="card"><view>{{error}}</view><view class="btn ghost" bindtap="retry">重新加载</view></view>
<view class="card" wx:if="{{items.length}}">
  <view class="feed-item" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="goNote">
    <image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" class="feed-cover" />
    <view class="feed-cover feed-ph" wx:else>📝</view>
    <view style="flex:1;min-width:0">
      <view class="feed-title">{{item.title || '无标题笔记'}}<text wx:if="{{item.hasVideo}}" class="tag">视频</text></view>
      <view class="sub2">{{item.author}} · {{item.when}}{{item.productText}}</view>
      <view class="feed-actions">
        <text catchtap="like" data-id="{{item.id}}" data-liked="{{item.liked}}" style="{{item.liked ? 'color:#e87722' : ''}}">{{item.liked ? '♥' : '♡'}} {{item.likeCount}}</text>
        <text style="color:var(--sub,#8a919c)">举报请进详情 ›</text>
      </view>
    </view>
  </view>
  <view wx:if="{{hasMore}}" class="btn ghost" bindtap="fetch">加载更多</view>
</view>
<view wx:elif="{{!loading && !error}}" class="empty"><view class="e-ico">🏮</view>还没有公开笔记 · 抢先发一篇</view>
<view class="note">内容均通过平台安全检测 · 发现违规可在笔记详情页举报</view>
<view class="btn" bindtap="goCreate" style="margin:16rpx 32rpx">去发布我的笔记</view>
