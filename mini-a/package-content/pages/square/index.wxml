<view class="hero"><view class="hi">旅行笔记广场</view><view class="sub2">看看大家去了哪 · 点赞支持创作者</view></view>
<view wx:if="{{error}}" class="card"><view>{{error}}</view><view class="btn ghost" bindtap="retry">重新加载</view></view>
<view wx:if="{{leftItems.length || rightItems.length}}" class="wf">
  <view class="wf-col">
    <view class="wf-card" wx:for="{{leftItems}}" wx:key="id" data-id="{{item.id}}" bindtap="goNote">
      <view class="wf-cover-box">
        <image wx:if="{{item.cover}}" class="wf-cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
        <view wx:else class="wf-cover wf-ph">📝</view>
        <view wx:if="{{item.hasVideo}}" class="wf-play">▶</view>
      </view>
      <view class="wf-title">{{item.title || '无标题笔记'}}</view>
      <view class="wf-meta">
        <image wx:if="{{item.avatar}}" class="wf-avatar" src="{{item.avatar}}" mode="aspectFill" />
        <view wx:else class="wf-avatar wf-avatar-ph">{{item.authorChar}}</view>
        <text class="wf-author">{{item.author}}</text>
        <text class="wf-like" catchtap="like" data-id="{{item.id}}" data-liked="{{item.liked}}">{{item.liked ? '♥' : '♡'}} {{item.likeCount}}</text>
      </view>
    </view>
  </view>
  <view class="wf-col">
    <view class="wf-card" wx:for="{{rightItems}}" wx:key="id" data-id="{{item.id}}" bindtap="goNote">
      <view class="wf-cover-box">
        <image wx:if="{{item.cover}}" class="wf-cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
        <view wx:else class="wf-cover wf-ph">📝</view>
        <view wx:if="{{item.hasVideo}}" class="wf-play">▶</view>
      </view>
      <view class="wf-title">{{item.title || '无标题笔记'}}</view>
      <view class="wf-meta">
        <image wx:if="{{item.avatar}}" class="wf-avatar" src="{{item.avatar}}" mode="aspectFill" />
        <view wx:else class="wf-avatar wf-avatar-ph">{{item.authorChar}}</view>
        <text class="wf-author">{{item.author}}</text>
        <text class="wf-like" catchtap="like" data-id="{{item.id}}" data-liked="{{item.liked}}">{{item.liked ? '♥' : '♡'}} {{item.likeCount}}</text>
      </view>
    </view>
  </view>
</view>
<view wx:elif="{{!loading && !error}}" class="empty"><view class="e-ico">🏮</view>还没有公开笔记 · 抢先发一篇</view>
<view wx:if="{{hasMore}}" class="btn ghost" bindtap="more" style="margin:20rpx 32rpx">加载更多</view>
<view class="note">内容均通过平台安全检测 · 发现违规可在笔记详情页举报</view>
<view class="btn" bindtap="goCreate" style="margin:16rpx 32rpx">去发布我的笔记</view>
