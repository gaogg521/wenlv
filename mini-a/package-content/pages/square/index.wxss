.feed-item { display: flex; gap: 16rpx; padding: 20rpx 0; border-bottom: 1rpx solid var(--line, #eee); }
.feed-cover { width: 140rpx; height: 140rpx; border-radius: 16rpx; flex-shrink: 0; background: #f3ece2; }
.feed-ph { display: flex; align-items: center; justify-content: center; font-size: 52rpx; }
.feed-title { font-size: 28rpx; font-weight: 700; }
.feed-actions { display: flex; gap: 24rpx; margin-top: 10rpx; font-size: 24rpx; }
