/* 双列瀑布流（小红书式）：3:4 封面卡 + 标题两行 + 作者行 */
.wf { display: flex; gap: 16rpx; padding: 0 24rpx; }
.wf-col { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 20rpx; }
.wf-card { background: #fff; border-radius: 16rpx; overflow: hidden; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.05); }
.wf-cover-box { position: relative; width: 100%; }
.wf-cover { display: block; width: 100%; height: 472rpx; background: #f3ece2; }
.wf-ph { display: flex; align-items: center; justify-content: center; padding: 24rpx; box-sizing: border-box;
  background: var(--brand-soft, #fdf1e3); }
.wf-ph-text { font-size: 30rpx; font-weight: 600; color: #8a5a1f; line-height: 1.6; word-break: break-all;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4; overflow: hidden; }
.wf-play { position: absolute; left: 14rpx; bottom: 14rpx; width: 44rpx; height: 44rpx; line-height: 44rpx; text-align: center;
  border-radius: 50%; background: rgba(0,0,0,.5); color: #fff; font-size: 20rpx; }
.wf-title { padding: 14rpx 16rpx 6rpx; font-size: 27rpx; font-weight: 600; color: #1f2937;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; line-height: 1.4; }
.wf-meta { display: flex; align-items: center; gap: 10rpx; padding: 6rpx 16rpx 16rpx; }
.wf-avatar { width: 36rpx; height: 36rpx; border-radius: 50%; flex-shrink: 0; background: #f0f0f0; }
.wf-avatar-ph { display: flex; align-items: center; justify-content: center; font-size: 20rpx; color: #68707c; }
.wf-author { flex: 1; min-width: 0; font-size: 22rpx; color: #68707c; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wf-like { font-size: 22rpx; color: #68707c; flex-shrink: 0; }

/* 话题聚合（三期①）：搜索条 + 过滤头 + 卡片话题 chips */
.topic-bar { display: flex; align-items: center; gap: 14rpx; }
.topic-input { flex: 1; min-width: 0; background: #f4f1ea; border-radius: 32rpx; padding: 14rpx 24rpx; font-size: 26rpx; }
.topic-go { flex-shrink: 0; font-size: 25rpx; color: var(--brand, #e87722); font-weight: 600; padding: 10rpx 8rpx; }
.topic-filter { display: flex; align-items: center; justify-content: space-between; }
.tf-chip { font-size: 26rpx; color: var(--brand, #e87722); font-weight: 700; }
.tf-clear { font-size: 23rpx; color: #68707c; }
.wf-topics { display: flex; flex-wrap: wrap; gap: 10rpx; padding: 0 16rpx; }
.wf-topic { font-size: 21rpx; color: #c2661b; background: #fdf3e7; border-radius: 10rpx; padding: 4rpx 12rpx; }
