/* 双列瀑布流（小红书式）：3:4 封面卡 + 标题两行 + 作者行 */
.wf { display: flex; gap: 16rpx; padding: 0 24rpx; }
.wf-col { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 20rpx; }
.wf-card { background: #fff; border-radius: 16rpx; overflow: hidden; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.05); }
.wf-cover-box { position: relative; width: 100%; }
.wf-cover { display: block; width: 100%; height: 472rpx; background: #f3ece2; }
.wf-ph { display: flex; align-items: center; justify-content: center; font-size: 72rpx; }
.wf-play { position: absolute; left: 14rpx; bottom: 14rpx; width: 44rpx; height: 44rpx; line-height: 44rpx; text-align: center;
  border-radius: 50%; background: rgba(0,0,0,.5); color: #fff; font-size: 20rpx; }
.wf-title { padding: 14rpx 16rpx 6rpx; font-size: 27rpx; font-weight: 600; color: #1f2937;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; line-height: 1.4; }
.wf-meta { display: flex; align-items: center; gap: 10rpx; padding: 6rpx 16rpx 16rpx; }
.wf-avatar { width: 36rpx; height: 36rpx; border-radius: 50%; flex-shrink: 0; background: #f0f0f0; }
.wf-avatar-ph { display: flex; align-items: center; justify-content: center; font-size: 20rpx; color: #9ca3af; }
.wf-author { flex: 1; min-width: 0; font-size: 22rpx; color: #9ca3af; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wf-like { font-size: 22rpx; color: #9ca3af; flex-shrink: 0; }
