<block wx:if="{{d}}">
  <view class="hero">
    <view class="sub2">{{lex.did}} · Travel ID</view>
    <view class="hi" style="font-size:44rpx">{{d.profile.nickname}}</view>
    <view class="sub2">{{d.profile.levelName}} · 成长值 {{d.profile.growth}}</view>
  </view>
  <view class="sec-title" wx:if="{{d.badges.length}}">{{lex.badge}}墙 <text class="more">已点亮 {{ownedCount}}/{{d.badges.length}}</text></view>
  <block wx:for="{{groups}}" wx:key="key" wx:for-item="g">
    <view class="bdg-group">{{g.label}}<text class="more">{{g.got}}/{{g.items.length}}</text></view>
    <view class="badge-wall">
      <view class="bdg {{item.owned ? 'on' : ''}} r-{{item.rarity}}" wx:for="{{g.items}}" wx:key="id" bindtap="showBadge" data-id="{{item.id}}" style="{{item.owned && item.color ? '--bc:' + item.color : ''}}">
        <image class="bdg-img" src="{{item.iconImg || item.art}}" mode="aspectFit" />
        <view class="bdg-name">{{item.name}}</view>
        <view class="bdg-r" wx:if="{{item.owned}}">{{item.rarityLabel}}{{item.expired ? ' · 已过期' : ''}}</view>
        <view class="bdg-prog" wx:if="{{!item.owned && item.progress}}"><view class="bdg-prog-fill" style="width:{{item.progress.pct}}%"></view></view>
        <view class="bdg-r" wx:if="{{!item.owned && item.progress}}">{{item.progress.cur}}/{{item.progress.need}}</view>
        <view class="bdg-r" wx:if="{{!item.owned && !item.progress}}">未获得</view>
      </view>
    </view>
  </block>
  <view class="sec-title">我的{{lex.pass}}（{{d.passes.length}}）<text class="more">核销后记录永久有效</text></view>
  <view class="card" wx:for="{{d.passes}}" wx:key="id">
    <view class="kv"><text>{{item.name}}</text><text class="v">{{item.statusText}}</text></view>
  </view>
  <view class="sec-title">{{lex.attest_list}}（{{d.attestations.length}}）<text class="more">消费与权益的可信记录</text></view>
  <view class="card" wx:for="{{d.attestations}}" wx:key="orderNo">
    <view class="kv"><text class="ts">{{item.orderNo}}</text><text class="v">{{item.sealed?'已封存':'校验中'}}</text></view>
    <view class="muted2">校验码 {{item.code}}</view>
  </view>
  <view class="note">{{lex.note}}</view>
</block>
<view wx:else class="empty">{{loadTxt}}</view>
