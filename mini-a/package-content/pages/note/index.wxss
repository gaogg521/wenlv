/* 笔记详情（小红书式）：图集轮播 + 白底正文卡 + 评论区 + 底部操作栏 */
page { background: #fff; }
.note-back-row { padding: 0 24rpx; border-bottom: 1rpx solid #eee9e2; }
.note-back { width: auto; min-height: 88rpx; line-height: 88rpx; margin: 0; padding: 0 12rpx; text-align: left; background: transparent; color: #86502e; font-size: 28rpx; font-weight: 600; }
.note-back::after { border: none; }
.detail { padding-bottom: calc(120rpx + env(safe-area-inset-bottom)); }
.detail-reply { padding-bottom: calc(188rpx + env(safe-area-inset-bottom)); }
.detail-attachment { padding-bottom: calc(204rpx + env(safe-area-inset-bottom)); }
.detail-reply.detail-attachment { padding-bottom: calc(272rpx + env(safe-area-inset-bottom)); }

/* 图集 */
.note-gallery { position: relative; width: 100%; overflow: hidden; background: #f2f3f5; }
.gallery-swiper { height: 640rpx; }
.gallery-img { display: block; width: 100%; height: 100%; }
.gallery-page { position: absolute; right: 24rpx; bottom: 20rpx; padding: 4rpx 18rpx; border-radius: 999rpx;
  background: rgba(0,0,0,.55); color: #fff; font-size: 22rpx; }
.detail-video { width: 100%; height: 560rpx; background: #111; }

/* 正文卡 */
.body-card { padding: 32rpx 32rpx 36rpx; }
.author-row { display: flex; align-items: center; gap: 16rpx; padding-bottom: 20rpx; }
.author-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; flex-shrink: 0; background: #f0f0f0; }
.author-ph { display: flex; align-items: center; justify-content: center; color: #68707c; font-size: 30rpx; }
.author-main { flex: 1; min-width: 0; }
.author-name { font-size: 28rpx; font-weight: 600; color: #1f2937; }
.author-time { font-size: 22rpx; color: #68707c; margin-top: 4rpx; }
.author-product { max-width: 240rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  font-size: 22rpx; color: var(--brand, #e87722); background: var(--brand-soft, #fdf1e3); padding: 8rpx 16rpx; border-radius: 999rpx; }
.detail-title { font-size: 38rpx; font-weight: 700; color: #111; line-height: 1.4; margin-bottom: 16rpx; }
.detail-body { font-size: 30rpx; line-height: 1.8; color: #1f2937; word-break: break-word; }
.article-plain { display: block; }
.article-block { display: block; width: 100%; margin: 14rpx 0; word-break: break-word; line-height: 1.8; }

/* 话题 */
.topics-line { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.topic-tag { color: var(--brand, #e87722); font-size: 27rpx; font-weight: 600; }
.like-sum { margin-top: 20rpx; font-size: 26rpx; color: var(--brand, #e87722); }

/* 评论区（小红书式） */
.comments { padding: 30rpx 32rpx 20rpx; border-top: 8rpx solid #f4f2ee; }
.c-head { display: flex; align-items: center; gap: 12rpx; font-size: 32rpx; font-weight: 700; color: #21241f; margin-bottom: 12rpx; }
.c-count { color: #675f55; font-size: 24rpx; font-weight: 500; }
.c-item { display: flex; gap: 16rpx; padding: 24rpx 0 16rpx; }
.c-item + .c-item { border-top: 1rpx solid #efede9; }
.c-avatar { width: 60rpx; height: 60rpx; border-radius: 50%; flex-shrink: 0; background: #f0f0f0; }
.c-avatar-ph { display: flex; align-items: center; justify-content: center; color: #68707c; font-size: 26rpx; }
.c-main { flex: 1; min-width: 0; }
.c-name { font-size: 27rpx; font-weight: 600; color: #343831; display: flex; align-items: center; gap: 10rpx; }
.c-tag { font-size: 20rpx; color: var(--brand, #e87722); border: 1rpx solid var(--brand, #e87722); border-radius: 6rpx; padding: 0 8rpx; }
.c-rto { font-size: 24rpx; color: #68707c; }
.c-content { font-size: 28rpx; color: #1f2937; line-height: 1.6; margin: 6rpx 0; word-break: break-word; }
.c-img { width: 240rpx; height: 240rpx; border-radius: 12rpx; margin: 8rpx 0; }
.c-foot { display: flex; align-items: center; gap: 24rpx; margin-top: 6rpx; }
.c-time { font-size: 22rpx; color: #706b63; }
.c-act { padding: 14rpx 0; font-size: 24rpx; color: #86502e; }
.c-like { padding: 14rpx 0 14rpx 12rpx; margin-left: auto; font-size: 25rpx; color: #706b63; }
.c-like.on { color: #e0344a; }
.c-replies { margin-top: 8rpx; background: #faf8f4; border-radius: 12rpx; padding: 10rpx 18rpx; }
.c-reply { padding: 10rpx 0; border-bottom: 1rpx solid #eef0f2; }
.c-reply:last-child { border-bottom: none; }
.c-rname { font-size: 24rpx; font-weight: 600; color: #343831; display: flex; align-items: center; gap: 10rpx; flex-wrap: wrap; }
.c-reply .c-img { width: 180rpx; height: 180rpx; }
.c-more { text-align: center; padding: 14rpx 0; font-size: 24rpx; color: var(--brand, #e87722); }
.c-more-main { border-top: 1rpx solid #f0f0f0; margin-top: 8rpx; }
.c-empty { padding: 24rpx 0 18rpx; font-size: 26rpx; color: #706b63; }

/* 举报 */
.report-area { padding: 8rpx 32rpx 24rpx; }
.report-toggle,.report-submit { width: auto; margin: 8rpx 0 0; padding: 4rpx 0; background: transparent; color: #706b63; font-size: 23rpx; }
.report-toggle::after,.report-submit::after { border: none; }
.report-reason { width:100%;min-height:160rpx;margin-top:20rpx;border:1rpx solid #ddd;padding:16rpx;box-sizing:border-box; }

/* 底部操作栏 */
.action-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; padding: 10rpx 24rpx calc(10rpx + env(safe-area-inset-bottom)); background: #fff; border-top: 1rpx solid #ebe8e3; }
.ab-row, .ab-context { display: flex; align-items: center; gap: 6rpx; }
.ab-context { min-height: 68rpx; border-bottom: 1rpx solid #f1eee8; color: #86502e; }
.ab-context-label { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 24rpx; }
.ab-attachment { min-height: 84rpx; }
.ab-pending { width: 60rpx; height: 60rpx; border-radius: 8rpx; flex: none; }
.ab-input { flex: 1; min-width: 0; height: 72rpx; padding: 0 20rpx; border-radius: 36rpx; background: #f4f2ee; font-size: 26rpx; color: #282a26; }
.ab-mini, .ab-send { flex: 0 0 80rpx; width: 80rpx; min-width: 0; height: 84rpx; line-height: 84rpx; margin: 0; padding: 0; text-align: center; background: transparent; color: #3d3d37; font-size: 24rpx; white-space: nowrap; }
.ab-mini::after, .ab-send::after { border: none; }
.ab-act.on, .ab-mini.rec { color: #b83b50; }
.ab-send { flex-basis: 112rpx; width: 112rpx; height: 68rpx; line-height: 68rpx; border-radius: 34rpx; background: #b95726; color: #fff; }
.ab-send[disabled] { opacity: .65; color: #fff; }

/* 实况播放（Codex 素材线） */
.live-play { position: absolute; left: 14rpx; bottom: 14rpx; font-size: 22rpx; color: #fff;
  background: rgba(0,0,0,.62); border-radius: 999rpx; padding: 6rpx 20rpx; }
.live-mask { position: fixed; inset: 0; background: rgba(23,23,23,.93); z-index: 90;
  display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 28rpx; }
.live-video { width: 94%; height: 60vh; }
.live-close { width: auto; margin: 0; padding: 0 40rpx; border-radius: 999rpx;
  background: rgba(255,255,255,.14); color: #fff; font-size: 26rpx; }

/* 话题可点 + 景区行（三期①） */
.topic-tag { padding: 6rpx 14rpx; background: var(--brand-soft, #fdf1e3); border-radius: 10rpx; }
.scenic-line { margin-top: 18rpx; font-size: 25rpx; color: #6b7280; }
.private-chip { color: #6b7280; background: #f3f4f6; }

/* 评论骨架屏（三期③）：三段灰阶呼吸行 */
.c-skeleton { display: flex; gap: 16rpx; padding: 20rpx 0; }
.c-skeleton-inner { padding: 10rpx 0 0; }
.cs-avatar { width: 60rpx; height: 60rpx; border-radius: 50%; flex-shrink: 0; background: #eef0f2; animation: cs-breath 1.2s ease-in-out infinite; }
.cs-main { flex: 1; min-width: 0; }
.cs-line { height: 26rpx; border-radius: 8rpx; background: #eef0f2; margin: 10rpx 0; animation: cs-breath 1.2s ease-in-out infinite; }
.cs-line-short { width: 30%; }
.cs-line-thin { width: 70%; height: 20rpx; }
@keyframes cs-breath { 0%,100% { opacity: .55; } 50% { opacity: 1; } }

/* 语音评论（三期）：胶囊按钮 */
.c-audio { display: inline-flex; align-items: center; gap: 8rpx; margin: 8rpx 0; padding: 10rpx 24rpx; border-radius: 999rpx;
  background: var(--brand-soft, #fdf1e3); color: var(--brand, #e87722); font-size: 24rpx; }
.c-audio.on { background: var(--brand, #e87722); color: #fff; }
.c-media-state { font-size: 22rpx; color: #c0c4cc; margin: 4rpx 0; }
