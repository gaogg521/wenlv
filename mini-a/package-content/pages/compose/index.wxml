<view class="wrap">
  <!-- 第一步 · 媒体入口（未选时） -->
  <view wx:if="{{!hasMedia}}" class="entry-area">
    <view class="entry-hero">📝</view>
    <view class="entry-tip">选几张照片，记录这次旅行</view>
    <view class="entry-card" bindtap="pickImages"><text class="e-ico">🖼</text><text class="e-name">图文</text><text class="e-sub">最多 9 张图片</text></view>
    <view class="entry-card" bindtap="pickVideo"><text class="e-ico">🎬</text><text class="e-name">视频</text><text class="e-sub">30 秒 · 8MB 内</text></view>
    <view class="entry-card" bindtap="openGuide"><text class="e-name">做攻略图</text><text class="e-sub">选模板生成图片</text></view>
    <view class="entry-card" bindtap="skipMedia"><text class="e-ico">✏️</text><text class="e-name">纯文字</text><text class="e-sub">先写下想法</text></view>
  </view>

  <!-- 图集轮播（小红书同款：页码 / 删除 / 设为封面） -->
  <view wx:if="{{images.length}}" class="media-area">
    <view wx:if="{{showGallery}}" class="sheet-mask gallery-mask" bindtap="closeGallery">
      <view class="gallery-panel" catchtap="noop">
        <button class="gallery-close" bindtap="closeGallery">关闭预览</button>
        <view class="media-stage">
      <swiper class="media-swiper" current="{{current}}" bindchange="onSwiper">
        <swiper-item wx:for="{{images}}" wx:key="key">
          <view class="media-cell">
            <app-image class="media-img" src="{{item.src}}" mode="aspectFit" data-i="{{index}}" bindtap="previewCurrent" />
            <view wx:if="{{item.isCover}}" class="cover-badge">封面</view>
            <view wx:if="{{item.isLive}}" class="live-badge" catchtap="toggleLive" data-i="{{index}}">▶ 实况 · 点击移除</view>
            <view wx:if="{{item.uploading}}" class="media-flag">上传中…</view>
            <view wx:elif="{{item.failed}}" class="media-flag bad" catchtap="retryItem" data-key="{{item.key}}">上传失败 · 点重试</view>
            <view class="media-del" catchtap="removeImage" data-key="{{item.key}}">✕</view>
          </view>
        </swiper-item>
      </swiper>
      <view wx:if="{{mediaLabel}}" class="media-page">{{mediaLabel}}</view>
        </view>
        <view class="media-actions">
          <view class="m-act" bindtap="setCover">设为封面</view>
          <view class="m-act" bindtap="toggleLive" data-i="{{current}}">▶ 实况</view>
        </view>
      </view>
    </view>
    <!-- 缩略图条（三期拖拽排序：长按拖动调整顺序，封面跟随） -->
    <scroll-view id="thumbStrip" class="thumb-strip" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="thumb-row">
        <view wx:for="{{thumbs}}" wx:key="key"
          class="thumb thumb-photo {{item.isDragging ? 'dragging' : ''}} {{item.isTarget ? 'target' : ''}}"
          data-i="{{item.i}}" bindtap="openGallery" catchlongpress="thumbLongPress" catchtouchmove="thumbMove" catchtouchend="thumbEnd">
          <app-image class="thumb-img" src="{{item.src}}" mode="aspectFill" />
          <view wx:if="{{item.isCover}}" class="thumb-tag">封面</view>
          <view wx:if="{{item.isLive}}" class="thumb-live">▶</view>
          <view wx:if="{{item.uploading}}" class="thumb-state">上传中</view>
          <view wx:elif="{{item.failed}}" class="thumb-state bad">失败</view>
          <view wx:if="{{item.isDragging}}" class="thumb-drag-tip">拖到目标位置</view>
        </view>
        <view wx:if="{{canAddMore}}" class="thumb thumb-add" bindtap="pickImages">＋</view>
      </view>
    </scroll-view>

  </view>

  <!-- 视频位 -->
  <view wx:if="{{video}}" class="media-area">
    <view class="video-stage">
      <video class="video-player" src="{{video.src}}" controls object-fit="contain"></video>
      <view wx:if="{{video.uploading}}" class="media-flag">上传中…</view>
      <view wx:elif="{{video.failed}}" class="media-flag bad" catchtap="retryItem" data-key="{{video.key}}">上传失败 · 点重试</view>
      <view class="media-del" catchtap="removeVideo">✕</view>
    </view>
    <view class="media-actions">
      <view class="m-act" bindtap="openVideoEdit">✂️ 剪辑</view>
      <view class="m-act" bindtap="pickVideo">换一个视频</view>
    </view>
  </view>

  <!-- 第二步 · 编辑区 -->
  <view wx:if="{{hasMedia}}" class="form-area">
    <view class="title-row">
      <input class="title-input" maxlength="20" value="{{title}}" bindinput="onTitle" placeholder="添加标题" />
      <text class="title-count">{{titleLen}}/20</text>
    </view>
    <view wx:if="{{confirmTitle}}" class="title-hint">已为你拟好标题，可修改后确认发布。</view>
    <view class="fmt-row">
      <view class="fmt-btn {{formats.bold ? 'on' : ''}}" catchtouchend="rtCmd" data-tag="b"><b>B</b></view>
      <view class="fmt-btn {{formats.italic ? 'on' : ''}}" catchtouchend="rtCmd" data-tag="i"><i>I</i></view>
      <view class="fmt-btn" catchtouchend="rtCmd" data-tag="ul">≡</view>
      <text class="body-count">{{bodyLen}} 字</text>
    </view>
    <editor id="bodyEditor" class="body-editor" placeholder="添加笔记描述…" bindready="onEditorReady" bindinput="onEditorInput" bindstatuschange="onEditorStatus"></editor>
    <view class="topics-row">
      <view class="topic-chip" wx:for="{{topics}}" wx:key="*this" bindtap="removeTopic" data-t="{{item}}">#{{item}} ✕</view>
      <view class="topic-add" bindtap="openTopicSheet"># 添加话题</view>
    </view>
    <!-- 可见范围（三期 V88）：公开 / 私密 -->
    <view class="kv-line vis-line">
      <text class="kv-k">👁 谁可以看</text>
      <view class="vis-opts">
        <view class="vis-opt {{visPublicOn ? 'on' : ''}}" bindtap="setVisibility" data-v="public">公开</view>
        <view class="vis-opt {{visPrivateOn ? 'on' : ''}}" bindtap="setVisibility" data-v="private">仅自己</view>
      </view>
    </view>
    <view class="kv-line" bindtap="pickScenic">
      <text class="kv-k">🏞 关联景区</text>
      <text class="kv-v">{{scenicName || '选填，笔记会进该景区的话题页'}} ›</text>
    </view>
    <view class="kv-line" bindtap="pickProduct">
      <text class="kv-k">📍 关联线路</text>
      <text class="kv-v">{{relatedName || '选填，让笔记被更多旅人看到'}} ›</text>
    </view>
    <view wx:if="{{canAddMore}}" class="kv-line" bindtap="openGuide"><text class="kv-k">做攻略图</text><text class="kv-v">用文字和照片生成图片 ›</text></view>
    <view class="kv-line {{canIdeas ? '' : 'off'}}" bindtap="openIdeas">
      <text class="kv-k">✨ 写作建议</text>
      <text class="kv-v">{{canIdeas ? '看图帮你起标题、写正文' : '上传照片后可用'}} ›</text>
    </view>
    <view wx:if="{{editId}}" class="edit-tip">正在编辑已发布作品 · 提交后将暂时撤下并重新审核</view>
    <view wx:if="{{cloudSavedAt}}" class="edit-tip">草稿已云存档，换设备也不丢</view>
  </view>
</view>

<!-- ✨ 写作建议面板 -->
<view wx:if="{{showIdeas}}" class="sheet-mask" bindtap="closeIdeas">
  <view class="idea-sheet" catchtap="noop">
    <view class="sheet-title">✨ 写作建议</view>
    <view class="idea-sub">根据照片和话题，帮你起标题、写正文；只描述画面里看得见的细节</view>
    <textarea class="idea-intent" value="{{writingIntent}}" bindinput="onIntentInput" maxlength="80"
      placeholder="想表达什么？例如：想记录慢下来的感觉（选填）"></textarea>
    <button class="idea-gen" bindtap="genIdeas" loading="{{visionBusy}}" disabled="{{visionBusy}}">{{visionResult ? '重新生成' : '生成文案'}}</button>
    <view wx:if="{{visionError}}" class="idea-error">{{visionError}}</view>
    <view wx:if="{{visionResult}}" class="idea-result">
      <view class="ir-title">{{visionResult.title}}</view>
      <view class="ir-text">{{visionResult.text}}</view>
      <view class="ir-guide">排版建议：{{visionResult.guideLabel}}<text class="ir-guide-sub">{{visionResult.guide ? '（按路线顺序组织图片）' : '（重点呈现画面氛围）'}}</text></view>
      <view wx:if="{{visionResult.reason}}" class="ir-reason">写作角度：{{visionResult.reason}}</view>
      <button class="ir-apply" bindtap="applyIdea">应用到笔记</button>
    </view>
  </view>
</view>

<!-- ✂️ 视频剪辑面板（Codex 素材线） -->
<view wx:if="{{videoEdit}}" class="sheet-mask" bindtap="closeVideoEdit">
  <view class="ve-sheet" catchtap="noop">
    <view class="sheet-title">✂️ 视频剪辑</view>
    <video class="ve-video" src="{{videoEdit.src}}" controls object-fit="contain" bindloadedmetadata="onVeMeta"></video>
    <view class="ve-row"><text class="ve-k">保留 {{videoEdit.start}}s – {{videoEdit.end}}s / 共 {{videoEdit.duration}}s</text></view>
    <view class="ve-row"><text class="ve-k">起点</text><slider class="ve-slider" min="0" max="{{videoEdit.duration}}" step="0.1" value="{{videoEdit.start}}" block-size="20" bindchange="changeVeTime" data-field="start" /></view>
    <view class="ve-row"><text class="ve-k">终点</text><slider class="ve-slider" min="0" max="{{videoEdit.duration}}" step="0.1" value="{{videoEdit.end}}" block-size="20" bindchange="changeVeTime" data-field="end" /></view>
    <view class="ve-row"><text class="ve-k">封面帧</text><slider class="ve-slider" min="0" max="{{videoEdit.duration}}" step="0.1" value="{{videoEdit.frame}}" block-size="20" bindchange="changeVeTime" data-field="frame" /></view>
    <view class="ve-row"><text class="ve-k">滤镜</text>
      <view class="ve-opts">
        <view class="ve-opt {{videoEdit.look === 'original' ? 'on' : ''}}" bindtap="changeVeLook" data-look="original">原图</view>
        <view class="ve-opt {{videoEdit.look === 'warm' ? 'on' : ''}}" bindtap="changeVeLook" data-look="warm">暖调</view>
        <view class="ve-opt {{videoEdit.look === 'mono' ? 'on' : ''}}" bindtap="changeVeLook" data-look="mono">黑白</view>
        <view class="ve-opt {{videoEdit.look === 'vivid' ? 'on' : ''}}" bindtap="changeVeLook" data-look="vivid">鲜艳</view>
      </view>
    </view>
    <view class="ve-row"><text class="ve-k">角标</text>
      <view class="ve-opts">
        <view class="ve-opt {{videoEdit.sticker === '' ? 'on' : ''}}" bindtap="changeVeSticker" data-sticker="">无</view>
        <view class="ve-opt {{videoEdit.sticker === 'scenic' ? 'on' : ''}}" bindtap="changeVeSticker" data-sticker="scenic">旅行打卡</view>
        <view class="ve-opt {{videoEdit.sticker === 'walk' ? 'on' : ''}}" bindtap="changeVeSticker" data-sticker="walk">慢慢走</view>
        <view class="ve-opt {{videoEdit.sticker === 'guide' ? 'on' : ''}}" bindtap="changeVeSticker" data-sticker="guide">路线攻略</view>
      </view>
    </view>
    <view class="ve-row"><text class="ve-k">全程字幕</text><input class="ve-input" value="{{videoEdit.caption}}" bindinput="onVeCaption" maxlength="36" placeholder="如：外滩漫步（≤36字）" /></view>
    <view class="ve-row"><text class="ve-k">配乐</text>
      <view class="ve-opts">
        <switch checked="{{videoEdit.music}}" bindchange="changeVeMusic" />
        <text class="ve-sub">内置 BGM</text>
        <view class="ve-opt {{videoEdit.hasMusicAsset ? 'on' : ''}}" bindtap="pickVeAsset" data-kind="music">{{videoEdit.hasMusicAsset ? '✓ 自定义音乐' : '+ 自定义音乐'}}</view>
        <view class="ve-opt {{videoEdit.hasStickerAsset ? 'on' : ''}}" bindtap="pickVeAsset" data-kind="sticker">{{videoEdit.hasStickerAsset ? '✓ 自定义贴纸' : '+ 自定义贴纸'}}</view>
      </view>
    </view>
    <view class="ve-row" wx:if="{{videoEdit.captions.length}}">
      <view class="ve-cap" wx:for="{{videoEdit.captions}}" wx:key="i">
        <input class="ve-input ve-cap-text" value="{{item.text}}" bindinput="changeVeCaption" data-i="{{item.i}}" data-field="text" maxlength="36" placeholder="分段字幕 {{item.i}}" />
        <text class="ve-cap-del" catchtap="removeVeCaption" data-i="{{item.i}}">✕</text>
      </view>
      <view wx:if="{{videoEdit.captions.length < 12}}" class="ve-add-cap" bindtap="addVeCaption">＋ 按当前区间加分段字幕</view>
    </view>
    <view wx:if="{{videoEdit.veError}}" class="ve-error">{{videoEdit.veError}}</view>
    <view class="ve-actions">
      <button class="ve-btn" bindtap="useVeFrame" disabled="{{veBusy}}">封面帧</button>
      <button class="ve-btn primary" bindtap="applyVeTrim" loading="{{veBusy}}" disabled="{{veBusy}}">生成剪辑</button>
    </view>
  </view>
</view>

<!-- 话题选择面板 -->
<view wx:if="{{showTopicSheet}}" class="sheet-mask" bindtap="closeTopicSheet">
  <view class="topic-sheet" catchtap="noop">
    <view class="sheet-title">选择话题</view>
    <view class="topic-grid">
      <view class="topic-opt" wx:for="{{hotTopics}}" wx:key="*this" bindtap="addTopic" data-t="{{item}}">#{{item}}</view>
    </view>
    <view class="topic-custom" bindtap="customTopic">＋ 自定义话题</view>
  </view>
</view>

<view wx:if="{{showGuide}}" class="sheet-mask" bindtap="closeGuide">
  <view class="guide-sheet" catchtap="noop">
    <view class="guide-header"><text class="sheet-title">做攻略图</text><button bindtap="closeGuide" disabled="{{guideBusy}}">关闭</button></view>
    <scroll-view class="guide-content" scroll-y>
      <input class="guide-input" placeholder="攻略标题（选填）" maxlength="20" value="{{guideTitle}}" data-field="guideTitle" bindinput="editGuide" disabled="{{guideBusy}}" />
      <textarea class="guide-input guide-text" placeholder="每行写一个路线、景点或建议" maxlength="240" value="{{guideText}}" data-field="guideText" bindinput="editGuide" disabled="{{guideBusy}}" />
      <view wx:if="{{guidePhoto}}" class="guide-photo-row"><app-image class="guide-photo" src="{{guidePhoto}}" mode="aspectFill" /><button bindtap="clearGuidePhoto" disabled="{{guideBusy}}">移除照片</button></view>
      <button wx:else class="guide-photo-button" bindtap="pickGuidePhoto" disabled="{{guideBusy}}">＋ 添加照片</button>
      <view class="guide-styles">
        <button wx:for="{{guideStyles}}" wx:key="name" class="guide-style {{item.selected ? 'selected' : ''}}" style="background:{{item.background}};color:{{item.ink}}" data-index="{{index}}" bindtap="selectGuideStyle" disabled="{{guideBusy}}">{{item.name}}</button>
      </view>
      <app-image wx:if="{{guideImage}}" class="guide-preview" src="{{guideImage}}" mode="widthFix" />
    </scroll-view>
    <view class="guide-actions">
      <button class="ve-btn" bindtap="generateGuide" disabled="{{guideBusy}}" loading="{{guideBusy}}">{{guideImage ? '重新生成' : '生成预览'}}</button>
      <button class="ve-btn primary" bindtap="insertGuide" disabled="{{guideBusy || !guideImage}}">插入笔记</button>
    </view>
  </view>
  <canvas class="guide-canvas" canvas-id="guideCard" style="width:720px;height:{{guideHeight}}px" />
</view>

<!-- 底部发布栏 -->
<view class="bottom-bar">
  <text class="bar-hint">{{barHint}}</text>
  <button class="pub-btn {{canPublish ? '' : 'off'}}" bindtap="publish" loading="{{busy}}" disabled="{{busy || !canPublish}}">{{publishLabel}}</button>
</view>
