<view wx:if="{{error}}" class="card"><view>{{error}}</view><view class="btn ghost" bindtap="load">重新加载</view></view>
<view wx:elif="{{!t}}" class="skeleton" style="height:360rpx;margin-top:20rpx"></view>
<block wx:else>
  <image wx:if="{{t.cover_img}}" class="gallery" src="{{t.cover_img}}" mode="aspectFill" />
  <view class="book-bar dt-head" style="{{t.cover_img ? '' : 'margin-top:24rpx'}}">
    <view class="dt-title">{{t.title}}</view>
    <view class="dt-meta">
      <text class="tag">{{t.category_label}}</text>
      <text class="tag blue" wx:for="{{t.tags}}" wx:key="*this">#{{item}}</text>
    </view>
    <view class="dt-price-row">
      <view><text class="tour-price" style="font-size:40rpx">{{t.reward_beans}}</text><text class="muted2"> 旅豆</text>
        <text wx:if="{{t.cash_reward_label}}" class="tk-cash">+ ¥{{t.cash_reward_label}} 现金</text></view>
      <text class="muted2" wx:if="{{t.deadlineText}}">截止 {{t.deadlineText}}</text>
    </view>
  </view>

  <view class="card">
    <view class="rich-p">{{t.brief}}</view>
    <view class="kv" wx:if="{{t.platformsText}}"><text>建议发布</text><text class="v">{{t.platformsText}}</text></view>
    <view class="kv" wx:if="{{t.min_words || t.min_images}}"><text>作品要求</text><text class="v">{{t.min_words ? '不少于 ' + t.min_words + ' 字' : ''}}{{t.min_words && t.min_images ? ' · ' : ''}}{{t.min_images ? t.min_images + ' 张图以上' : ''}}</text></view>
    <view class="kv" wx:if="{{t.max_participants}}"><text>名额</text><text class="v">{{t.max_participants}} 人</text></view>
    <view class="kv" wx:if="{{t.product}}" bindtap="goProduct"><text>种草线路</text><text class="v pl-link">{{t.product.title}} ›</text></view>
  </view>

  <view class="sec-title" wx:if="{{t.rich_brief}}">任务说明</view>
  <view class="card" wx:if="{{t.rich_brief}}"><rich-text class="rich-p" nodes="{{t.rich_brief}}"></rich-text></view>

  <view class="sec-title" wx:if="{{t.must_mention.length || t.forbidden.length}}">内容要点</view>
  <view class="card" wx:if="{{t.must_mention.length || t.forbidden.length}}">
    <view class="fee-h" wx:if="{{t.must_mention.length}}">必须提及</view>
    <view class="hl-item" wx:for="{{t.must_mention}}" wx:key="*this"><text class="hl-dot ok">✓</text>{{item}}</view>
    <view class="fee-h" wx:if="{{t.forbidden.length}}" style="margin-top:14rpx">请勿出现</view>
    <view class="hl-item" wx:for="{{t.forbidden}}" wx:key="*this"><text class="hl-dot no">✕</text>{{item}}</view>
  </view>

  <view class="sec-title" wx:if="{{t.references.length}}">参考范例</view>
  <view class="card" wx:if="{{t.references.length}}">
    <view class="tk-ref" wx:for="{{t.references}}" wx:key="index" bindtap="openRef" data-url="{{item.url}}">
      <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="tk-ref-img" />
      <view style="flex:1">{{item.title}}<view class="muted2" wx:if="{{item.url}}">点击复制链接</view></view>
    </view>
  </view>

  <view class="sec-title" wx:if="{{t.review_rules.length}}">审核标准</view>
  <view class="card" wx:if="{{t.review_rules.length}}"><view class="hl-item" wx:for="{{t.review_rules}}" wx:key="*this"><text class="hl-dot">·</text>{{item}}</view></view>
  <view style="height:150rpx"></view>
  <view class="dt-bottom" wx:if="{{t.status === 0}}">
    <view class="dt-bottom-price">{{t.reward_beans}}<text class="muted2" style="font-size:22rpx;font-weight:400"> 旅豆{{t.cash_reward_label ? ' + ¥' + t.cash_reward_label : ''}}</text></view>
    <view class="btn dt-cta" bindtap="claim">领取任务</view>
  </view>
</block>
