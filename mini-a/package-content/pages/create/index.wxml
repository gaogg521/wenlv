<view class="hero">
  <view class="hi">创作中心</view>
  <view class="sub2">发布旅行笔记 · 内容过安全检测后展示 · 好内容获旅豆奖励</view>
</view>
<view class="card">
  <input value="{{title}}" bindinput="onTitle" placeholder="标题（选填）"
    style="border:1rpx solid var(--line);border-radius:16rpx;padding:16rpx 24rpx;margin-bottom:16rpx" />

  <!-- 富文本编辑器：工具栏 + textarea + 预览 -->
  <view class="rt-toolbar">
    <view class="rt-btn" catchtouchend="rtCmd" data-tag="h2">H2</view>
    <view class="rt-btn" catchtouchend="rtCmd" data-tag="h3">H3</view>
    <view class="rt-btn" catchtouchend="rtCmd" data-tag="b"><b>B</b></view>
    <view class="rt-btn" catchtouchend="rtCmd" data-tag="i"><i>I</i></view>
    <view class="rt-btn" catchtouchend="rtCmd" data-tag="ul">列表</view>
    <view class="rt-btn" catchtouchend="rtCmd" data-tag="quote">引用</view>
    <view class="rt-btn" catchtouchend="rtCmd" data-tag="br">换行</view>
    <view style="margin-left:auto;font-size:22rpx;color:var(--sub);align-self:center">{{bodyText.length}} 字</view>
  </view>
  <editor id="bodyEditor" class="body-editor" placeholder="写下这次旅行最值得记住的瞬间…" bindready="onEditorReady" bindinput="onEditorInput" bindstatuschange="onEditorStatus" style="min-height:320rpx;border:1rpx solid var(--line);padding:24rpx;box-sizing:border-box;font-size:28rpx;line-height:1.8"></editor>

  <view style="margin-top:16rpx">
    <view class="rt-btn" bindtap="togglePreview">{{showPreview ? '收起预览' : '预览效果'}}</view>
  </view>
  <rich-text wx:if="{{showPreview && bodyHtml}}" nodes="{{bodyHtml}}" style="margin-top:12rpx;padding:16rpx;background:#fafbfc;border-radius:12rpx;font-size:15rpx;line-height:1.7"></rich-text>

  <view class="btn" bindtap="publish" style="margin-top:16rpx">发布</view>
  <view class="note" wx:if="{{pubMsg}}">{{pubMsg}}</view>
</view>

<view class="sec-title">约稿任务</view>
<view class="card tk-card" wx:for="{{tasks.open}}" wx:key="id" bindtap="openTask" data-id="{{item.id}}">
  <image wx:if="{{item.cover}}" class="tk-cover" src="{{item.cover}}" mode="aspectFill" />
  <view style="flex:1;min-width:0">
    <view class="tour-title">{{item.title}}</view>
    <view class="muted2" style="margin:4rpx 0">{{item.brief}}</view>
    <view class="dt-meta"><text class="tag">{{item.categoryLabel}}</text><text class="tag blue" wx:for="{{item.tags}}" wx:for-item="tg" wx:key="*this">#{{tg}}</text></view>
    <view class="muted2" wx:if="{{item.deadline || item.platforms.length || item.slotsLeft !== null}}">{{item.platforms.length ? item.platforms.join('/') + ' · ' : ''}}{{item.deadline ? '截止 ' + item.deadline : ''}}{{item.slotsLeft !== null ? ' · 剩 ' + item.slotsLeft + ' 个名额' : ''}}</view>
  </view>
  <view class="tk-reward"><view class="tour-price" style="font-size:30rpx">{{item.reward_beans}}豆</view><view class="tk-cash" wx:if="{{item.cashLabel}}">+¥{{item.cashLabel}}</view><view class="muted2">查看 ›</view></view>
</view>
<view class="card" wx:if="{{tasks.mine.length}}">
  <view class="kv" wx:for="{{tasks.mine}}" wx:key="id">
    <text>{{item.title}}</text>
    <view class="v">{{item.statusText}}</view>
    <view wx:if="{{item.status === 1}}" class="v" bindtap="submitTask" data-id="{{item.id}}" style="color:var(--brand)">{{item.rejectReason ? '修改后重新提交' : '选择作品提交'}}</view>
  </view>
  <view class="reject-tip" wx:for="{{tasks.mine}}" wx:key="id" wx:if="{{item.rejectReason}}"><view class="reject-h">「{{item.title}}」未通过</view>{{item.rejectReason}}</view>
</view>
<view class="note" wx:if="{{!tasks.open.length && !tasks.mine.length}}">暂无约稿任务 · 发布优质笔记有机会被约稿</view>

<view class="sec-title">我的作品（{{notes.length}}）</view>
<view class="note" wx:if="{{loadError}}">{{loadError}}<button bindtap="fetch">重新加载</button></view>
<view class="card" wx:if="{{notes.length}}">
  <block wx:for="{{notes}}" wx:key="id">
    <view class="kv" bindtap="goNote" data-id="{{item.id}}"><text>{{item.title || '（无题）'}}</text><text class="v">{{item.statusText}} ›</text></view>
    <view class="reject-tip" wx:if="{{item.status === 3 && item.reject_reason}}"><view class="reject-h">未通过原因</view>{{item.reject_reason}}</view>
    <view class="reject-tip" wx:if="{{item.status === 4}}"><view class="reject-h">下架原因</view>{{item.offline_reason || '请联系平台了解详情'}}</view>
    <view class="note" wx:if="{{item.appealText}}">{{item.appealText}} {{item.appeal_resolution}}</view>
    <button class="appeal-open" wx:if="{{item.can_appeal}}" bindtap="openAppeal" data-id="{{item.id}}">申请复核</button>
    <view wx:if="{{appealNoteId === item.id}}">
      <textarea class="appeal-reason" value="{{appealReason}}" bindinput="onAppealReason" maxlength="300" placeholder="请说明申诉理由与事实依据（4—300 字）"></textarea>
      <button class="appeal-submit" bindtap="submitAppeal" loading="{{appealBusy}}" disabled="{{appealBusy}}">提交申诉</button>
    </view>
  </block>
</view>
<view class="note" wx:if="{{appealMsg}}">{{appealMsg}}</view>
<view class="sec-title">我的举报（最近 30 条）</view>
<view class="card" wx:for="{{reports}}" wx:key="id">
  <view>{{item.title || '旅行笔记'}} · {{item.statusText}}</view>
  <view class="note">举报原因：{{item.reason}}</view>
  <view class="note" wx:if="{{item.resolution}}">处理反馈：{{item.resolution}}</view>
</view>
<view class="note" wx:if="{{!reports.length}}">暂无举报记录</view>
<view class="note">领取任务后，选择一篇已发布的作品提交审核。审核通过后发放任务奖励。</view>
