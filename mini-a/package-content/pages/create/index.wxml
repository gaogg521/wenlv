<view class="hero">
  <view class="hi">创作中心</view>
  <view class="sub2">发布旅行笔记 · 内容过安全检测后展示 · 发布即得旅豆奖励</view>
</view>
<view class="card">
  <button class="btn compose-btn" bindtap="goCompose">＋ 发布新笔记</button>
  <view class="kv" style="display:flex;justify-content:space-between;align-items:center;padding:20rpx 0" bindtap="goSquare">
    <text>旅行笔记广场</text><text class="v">看看大家去了哪 ›</text>
  </view>
  <view class="note">图片和视频与正文分开上传 · 好内容有机会被约稿获得旅豆加现金奖励</view>
</view>

<view class="sec-title">约稿任务</view>
<view class="card tk-card" wx:for="{{tasks.open}}" wx:key="id" bindtap="openTask" data-id="{{item.id}}">
  <image wx:if="{{item.cover}}" class="tk-cover" src="{{item.cover}}" mode="aspectFill" />
  <view style="flex:1;min-width:0">
    <view class="tour-title">{{item.title}}</view>
    <view class="muted2" style="margin:4rpx 0">{{item.brief}}</view>
    <view class="dt-meta"><text class="tag">{{item.categoryLabel}}</text><text class="tag blue" wx:for="{{item.tags}}" wx:for-item="tg" wx:key="*this">#{{tg}}</text></view>
    <view class="muted2" wx:if="{{item.metaText}}">{{item.metaText}}</view>
  </view>
  <view class="tk-reward"><view class="tour-price" style="font-size:32rpx">{{item.reward_beans}}豆</view><view class="tk-cash" wx:if="{{item.cashLabel}}">+¥{{item.cashLabel}}</view><view class="muted2">查看 ›</view></view>
</view>
<view class="card" wx:if="{{tasks.mine.length}}">
  <view class="kv" wx:for="{{tasks.mine}}" wx:key="id">
    <text>{{item.title}}</text>
    <view class="v">{{item.statusText}}</view>
    <view wx:if="{{item.status === 1}}" class="v" bindtap="submitTask" data-id="{{item.id}}" style="color:var(--brand)">{{item.rejectReason ? '修改后重新提交' : '选择作品提交'}}</view>
  </view>
  <view class="reject-tip" wx:for="{{tasks.mine}}" wx:key="id" wx:if="{{item.rejectReason}}"><view class="reject-h">「{{item.title}}」未通过</view>{{item.rejectReason}}</view>
</view>
<view class="note" wx:if="{{!tasks.open.length && !tasks.mine.length}}">暂无约稿任务 · 发布优质笔记有机会被约稿</view>

<view class="sec-title">我的作品（{{notes.length}}）</view>
<view class="note" wx:if="{{loadError}}">{{loadError}}<button bindtap="fetch">重新加载</button></view>
<view class="work-tabs">
  <view class="w-tab {{workFilter === item.k ? 'on' : ''}}" wx:for="{{workTabs}}" wx:key="k" bindtap="onWorkFilter" data-k="{{item.k}}">{{item.name}}</view>
</view>
<view class="work-grid" wx:if="{{!worksEmpty}}">
  <view class="work-col" wx:for="{{worksCols}}" wx:key="index" wx:for-item="col">
    <view class="work-card" wx:for="{{col}}" wx:key="id" wx:for-item="item" bindtap="openWork" longpress="onWorkLongPress" data-id="{{item.id}}">
      <view class="wk-cover-box">
        <image wx:if="{{item.cover}}" class="wk-cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
        <view wx:else class="wk-cover wk-ph"><text class="wk-ph-text">{{item.coverChar}}</text></view>
        <view wx:if="{{item.hasVideo}}" class="wk-play">▶</view>
        <view class="wk-badge {{item.badgeClass}}">{{item.statusText}}</view>
      </view>
      <view class="wk-title">{{item.title || '（无题）'}}</view>
      <view class="wk-meta"><text>👍 {{item.like_count}}</text><text>💬 {{item.comment_count}}</text></view>
    </view>
  </view>
</view>
<view class="note" wx:if="{{worksEmpty && !loadError}}">这个状态下还没有作品 · 长按卡片可编辑/查看/复核</view>
<view class="card" wx:if="{{rejectTips.length}}">
  <block wx:for="{{rejectShown}}" wx:key="id">
    <view class="reject-tip" wx:if="{{item.status === 3 && item.reject_reason}}"><view class="reject-h">「{{item.title || '（无题）'}}」未通过原因</view>{{item.reject_reason}}</view>
    <view class="reject-tip" wx:if="{{item.status === 4}}"><view class="reject-h">「{{item.title || '（无题）'}}」下架原因</view>{{item.offline_reason || '请联系平台了解详情'}}</view>
    <view class="note" wx:if="{{item.appealText}}">{{item.appealText}} {{item.appeal_resolution}}</view>
    <view wx:if="{{appealNoteId === item.id}}">
      <textarea class="appeal-reason" value="{{appealReason}}" bindinput="onAppealReason" maxlength="300" placeholder="请说明申诉理由与事实依据（4—300 字）"></textarea>
      <button class="appeal-submit" bindtap="submitAppeal" loading="{{appealBusy}}" disabled="{{appealBusy}}">提交申诉</button>
    </view>
  </block>
  <view wx:if="{{rejectHidden > 0}}" class="c-more" bindtap="toggleRejectTips">展开其余 {{rejectHidden}} 条原因</view>
  <view wx:if="{{rejectShowAll}}" class="c-more" bindtap="toggleRejectTips">收起原因</view>
</view>
<view class="note" wx:if="{{appealMsg}}">{{appealMsg}}</view>
<view class="sec-title">我的举报（最近 30 条）</view>
<view class="card" wx:for="{{reports}}" wx:key="id">
  <view>{{item.title || '旅行笔记'}} · {{item.statusText}}</view>
  <view class="note">举报原因：{{item.reason}}</view>
  <view class="note" wx:if="{{item.resolution}}">处理反馈：{{item.resolution}}</view>
</view>
<view class="note" wx:if="{{!reports.length}}">暂无举报记录</view>
<view class="note">领取任务后，选择一篇已发布的作品提交审核。审核通过后发放任务奖励。</view>
