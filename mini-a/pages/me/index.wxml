<view wx:if="{{demo}}" style="background:#fff7e6;color:#b45309;padding:14rpx 24rpx;font-size:24rpx">演示模式（后端未连接）· 以下为演示数据，非真实内容</view>
<view class="hero">
  <block wx:if="{{user}}">
    <view class="me-card">
      <view class="me-ring">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
          <view wx:else class="avatar-ph">{{initial}}</view>
        </button>
      </view>
      <view class="me-main">
        <input class="nick-input" type="nickname" value="{{user.nickname}}" placeholder="填写昵称" bindblur="onNickname" />
        <view class="me-chips"><text class="me-chip">{{user.levelName}}</text><text class="me-chip ghost">文旅数字身份</text></view>
        <view class="lv-bar" wx:if="{{user.levelHint}}"><view class="lv-fill" style="width:{{user.levelPct}}%"></view></view>
        <view class="me-hint" wx:if="{{user.levelHint}}">{{user.levelHint}}</view>
      </view>
      <image class="me-crest" wx:if="{{user.levelArt}}" src="{{user.levelArt}}" mode="aspectFit" />
    </view>
  </block>
  <block wx:else>
    <view class="hi">未登录</view>
    <view class="btn ghost" style="margin:24rpx 0 0" bindtap="login">微信一键登录</view>
  </block>
</view>
<view class="card">
  <view class="kv" bindtap="goOrders"><text>我的订单</text><text class="v">›</text></view>
  <navigator class="kv" url="/package-promo/pages/freedom/index"><text>自由豆</text><text class="v">官方满减补贴 ›</text></navigator>
  <view class="kv" wx:if="{{canPromote}}" bindtap="goPromo"><text>推广中心</text><text class="v">我的推广身份 ›</text></view>
  <view class="kv" wx:if="{{workAvailable}}" bindtap="goWork"><text>合作中心</text><text class="v">主体 · 项目 · 分润 ›</text></view>
  <view class="kv" bindtap="goCreate"><text>创作中心</text><text class="v">›</text></view>
  <view class="kv" bindtap="goIdentity"><text>我的数字身份</text><text class="v">凭证 · 勋章 · 可信记录 ›</text></view>
  <view class="kv" bindtap="goFaq"><text>常见问题</text><text class="v">返豆 · 核销 · 退改 ›</text></view>
    <button class="kv contact-btn" open-type="contact"><text>联系客服</text><text class="v">官方会话 ›</text></button>
  <view class="kv" wx:if="{{site.service_phone}}" bindtap="callService"><text>客服电话</text><text class="v">{{site.service_phone}}{{serviceLine}} ›</text></view>
  <view class="kv" bindtap="showPrivacy"><text>设置与隐私</text><text class="v">{{consentOpen ? '收起 ⌃' : '隐私授权 ›'}}</text></view>
  <view wx:if="{{consentOpen}}" style="padding:8rpx 0 4rpx">
    <view class="note">下面每一项都能随时关掉，关掉不影响已经完成的行程与订单。</view>
    <view class="kv" wx:for="{{consents}}" wx:key="scene">
      <text>{{item.label}}<text class="note" wx:if="{{item.version}}" style="margin-left:8rpx">v{{item.version}}</text></text>
      <switch checked="{{item.granted}}" data-scene="{{item.scene}}" bindchange="consentToggle" color="#2f7d5d" />
    </view>
    <view class="note" wx:if="{{consentSavedAt}}">最近一次操作：{{consentSavedAt}}（已留档，可随时复核）</view>
  </view>
</view>
<view class="card">
  <view class="kv" bindtap="goDoc" data-type="agreement"><text>用户协议</text><text class="v">›</text></view>
  <view class="kv" bindtap="goDoc" data-type="privacy"><text>隐私政策</text><text class="v">›</text></view>
  <view class="kv" bindtap="goDoc" data-type="about"><text>关于{{site.brand_name}}</text><text class="v">›</text></view>
</view>
<view class="note">{{site.slogan || site.footer_line}}</view>
