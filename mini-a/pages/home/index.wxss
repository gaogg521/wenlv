/* 首页主题入口：双列留白、完整标题与轻量风景线条。 */
.theme-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; padding: 24rpx 32rpx 12rpx; }
.theme-tile { box-sizing: border-box; position: relative; min-height: 176rpx; padding: 24rpx; border-radius: 24rpx; border: 1rpx solid rgba(45,56,46,.06); box-shadow: none; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; }
.theme-tile.tg0 { background: #f7e9de; color: #874c31; }
.theme-tile.tg1 { background: #e6eee7; color: #365d4b; }
.theme-tile.tg2 { background: #f7efd8; color: #83662c; }
.theme-tile.tg3 { background: #e8eaf4; color: #53618b; }
.theme-top { display: flex; justify-content: space-between; align-items: center; position: relative; z-index: 1; }
.theme-mark { position: static; font-size: 34rpx; line-height: 1; color: inherit; opacity: .75; font-weight: 400; }
.theme-arrow { font-size: 28rpx; opacity: .45; }
.theme-body { position: relative; z-index: 1; }
.theme-name { font-size: 30rpx; font-weight: 600; letter-spacing: 1rpx; color: inherit; text-shadow: none; margin-top: 14rpx; white-space: nowrap; }
.theme-sub { font-size: 22rpx; line-height: 1.5; letter-spacing: 0; color: inherit; opacity: .72; margin-top: 5rpx; white-space: nowrap; }
.theme-landscape { position: absolute; width: 180rpx; height: 180rpx; border: 1rpx solid currentColor; border-radius: 50%; right: -75rpx; bottom: -105rpx; opacity: .13; }
.theme-landscape::after { content: ''; position: absolute; width: 140rpx; height: 140rpx; border: 1rpx solid currentColor; border-radius: 50%; right: 38rpx; bottom: 18rpx; }
