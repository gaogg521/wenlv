/* 首页旅行杂志视觉：图片仅作主题示意，标题与分类继续使用后台配置。 */
page { background: #f8f6f1; }
.home-intro { padding: 34rpx 36rpx 12rpx; background: linear-gradient(140deg, #f5eee2, #f8f6f1 75%); }
.eyebrow { color: #96846b; font-size:20rpx; letter-spacing: 3rpx; }
.home-title { font-size:56rpx; line-height: 1.2; letter-spacing: 0; margin: 20rpx 0 18rpx; font-weight:600; }
.home-title text { color: #a45230; }
.home-caption { font-size:24rpx; line-height: 1.75; color: #8a8072; max-width: 610rpx; }
.home-search { margin-top: 24rpx; padding: 22rpx 24rpx; border: 1rpx solid #e9e1d5; border-radius: 12rpx; box-shadow: 0 4rpx 16rpx rgba(67,49,23,.025); }
.home-search text { color: #927144; }
.home-destination { margin-top: 22rpx; padding-bottom: 12rpx; color: #928775; font-size:22rpx; }
.home-destination text { color: #5c7165; }
.theme-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; padding: 20rpx 32rpx 16rpx; }
.theme-tile { box-sizing: border-box; position: relative; min-height: 0; height: 246rpx; padding: 24rpx; border: 0; border-radius: 18rpx; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; color: #fff; background: #28372e; box-shadow: 0 9rpx 22rpx rgba(35,37,29,.10); }
.theme-tile.tg0,.theme-tile.tg1,.theme-tile.tg2,.theme-tile.tg3 { background: #28372e; }
.theme-scene { position: absolute; width: 100%; height: 100%; left: 0; top: 0; }
.theme-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(12,23,21,.10), rgba(12,23,21,.04) 26%, rgba(12,23,21,.69)); }
.theme-top { display: flex; align-items: center; gap: 12rpx; position: relative; z-index: 1; }
.theme-index { font-size:20rpx; line-height: 1; letter-spacing: 2rpx; color: rgba(255,255,255,.85); font-family: Georgia, serif; }
.theme-hairline { width: 32rpx; height: 1rpx; background: rgba(255,255,255,.45); }
.theme-body { position: relative; z-index: 1; padding-right: 30rpx; }
.theme-name { color: #fff; font-size:32rpx; line-height: 1.25; font-weight: 600; letter-spacing: 2rpx; margin: 0; white-space: nowrap; text-shadow: 0 2rpx 8rpx rgba(0,0,0,.15); }
.theme-sub { color: rgba(255,255,255,.82); font-size:20rpx; line-height: 1.5; letter-spacing: 1rpx; margin-top: 9rpx; white-space: nowrap; }
.theme-arrow { position: absolute; right: 22rpx; bottom: 29rpx; color: rgba(255,255,255,.9); font-size:28rpx; z-index: 1; }
.sec-title { margin-top: 24rpx; color: #393b32; }
.sec-title .more { color: #9a8a74; font-weight: 400; }
