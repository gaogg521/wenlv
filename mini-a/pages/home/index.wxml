<view wx:if="{{demo}}" style="background:#fff7e6;color:#b45309;padding:14rpx 24rpx;font-size:24rpx;border-radius:0 0 16rpx 16rpx">演示模式（后端未连接）· 以下为演示数据，非真实内容</view>
<view class="home-intro">
  <view class="eyebrow">{{site.hero_eyebrow}}</view>
  <view class="home-title">{{site.hero_title}}<text>{{site.hero_title_em}}</text></view>
  <view class="home-caption">{{site.hero_caption}}</view>
  <view class="home-search" bindtap="goTours">⌕ {{site.search_ph}} <text>探索 →</text></view>
  <view class="home-destination" bindtap="goDestinations">{{cityLine}}<text>{{cityAction}}</text></view>
</view>
<view class="theme-grid">
<view wx:for="{{themeEntries}}" wx:key="cat" class="theme-tile tg{{index}}" data-cat="{{item.cat}}" bindtap="goTours">
<image class="theme-scene" src="{{item.cover}}" mode="aspectFill" />
<view class="theme-shade"></view>
<view class="theme-top"><text class="theme-index">0{{index + 1}}</text><view class="theme-hairline"></view></view>
<view class="theme-body"><view class="theme-name">{{item.name}}</view><view class="theme-sub">{{item.sub}}</view></view>
<view class="theme-arrow">↗</view>
</view>
</view>
<swiper wx:if="{{banners.length}}" indicator-dots circular style="height:300rpx;margin:16rpx 0;border-radius:16rpx" bindchange="onBannerChange">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <image src="{{item.image}}" mode="aspectFill" style="width:100%;height:300rpx;background:{{item.bgColor || '#f3ece2'}}" data-i="{{index}}" bindtap="tapBanner" />
      <view wx:if="{{item.samplePhoto}}" class="photo-banner-copy" data-i="{{index}}" bindtap="tapBanner"><view>{{item.title}}</view><text>场景参考图 · 探索更多 →</text></view>
    </swiper-item>
  </swiper>


<view class="sec-title">{{site.section_title}} <text class="more" bindtap="goTours">查看全部 →</text></view>

<view wx:if="{{loading}}">
  <view class="skeleton" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
</view>
<view wx:elif="{{error}}" class="card"><view>{{error}}</view><view class="btn ghost" bindtap="fetch">重新加载</view></view>
<view wx:elif="{{!tours.length}}" class="empty"><view class="e-ico">🧳</view>暂无在架线路</view>
<view wx:else>
  <view class="tour-item fade-up" wx:for="{{tours}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
    <view wx:if="{{item.cover}}" class="tour-visual"><image class="tour-img" src="{{item.cover}}" mode="aspectFill" lazy-load /><text wx:if="{{item.sampleCover}}" class="tour-sample">主题示意图</text></view>
    <view wx:else class="tour-cover cover-{{index % 5}}">{{icons[index % 5]}}</view>
    <view style="flex:1;min-width:0">
      <view class="tour-title">{{item.title}}</view>
      <view class="tour-desc">{{item.desc || item.subtitle || '实景 · 深度 · 小团'}}</view>
      <view>
        <text class="tag">{{item.loc || item.city_code || '上海'}}</text>
        <text class="tag blue">{{item.days || item.days_desc || '1天'}}</text>
      </view>
      <view class="tour-price"><text class="rmb">¥</text>{{item.priceText}} <text class="u">完成得 {{item.beanGift || item.bean_gift}} 旅豆</text></view>
    </view>
  </view>
</view>
<view class="home-footer">{{site.footer_line}}<view>{{site.footer_sub}}</view></view>
