<view wx:if="{{demo}}" style="background:#fff7e6;color:#b45309;padding:14rpx 24rpx;font-size:24rpx;border-radius:0 0 16rpx 16rpx">演示模式（后端未连接）· 以下为演示数据，非真实内容</view>
<view wx:if="{{error}}" class="card"><view>{{error}}</view><view class="btn ghost" bindtap="retry">重新加载</view></view>

<view class="bn-hero">
  <view class="bn-top">
    <view>
      <view class="bn-label">我的旅豆</view>
      <view class="bn-num">{{bean ? bean.balance : '--'}}</view>
      <view class="bn-sub" wx:if="{{bean}}">约可抵 ¥{{bean.yuan}} · 100 豆抵 ¥10</view>
    </view>
    <image class="bn-coin" wx:if="{{bean.coinArt}}" src="{{bean.coinArt}}" mode="aspectFit" />
  </view>
  <view class="bn-chips" wx:if="{{bean}}">
    <view class="bn-chip"><view class="bn-cv">+{{bean.monthIn}}</view><view class="bn-cl">本月获得</view></view>
    <view class="bn-chip"><view class="bn-cv">−{{bean.monthOut}}</view><view class="bn-cl">本月使用</view></view>
    <view class="bn-chip {{bean.expiringSoon > 0 ? 'warn' : ''}}"><view class="bn-cv">{{bean.expiringSoon}}</view><view class="bn-cl">30 天内到期</view></view>
  </view>
</view>

<view class="bn-rules fade-up" wx:if="{{bean}}">
  <view class="bn-rule"><text class="bn-rv">消费返 {{bean.orderRatePct}}%</text><text class="bn-rl">完成订单后到账</text></view>
  <view class="bn-rule"><text class="bn-rv">{{bean.expireMonths}} 个月</text><text class="bn-rl">滚动有效</text></view>
  <view class="bn-rule"><text class="bn-rv">抵扣 ≤{{bean.deductMaxPct}}%</text><text class="bn-rl">单笔订单上限</text></view>
</view>

<view class="card fade-up" wx:if="{{beanIntro}}"><rich-text class="rich-p" nodes="{{beanIntro}}"></rich-text></view>

<view class="sec-title" wx:if="{{levels.length}}">会员等级 <text class="more">成长值随真实消费累积</text></view>
<view class="card fade-up bn-level" wx:if="{{levels.length}}">
  <view class="bn-lv-top">
    <image class="bn-crest" src="{{levelArt}}" mode="aspectFit" />
    <view class="bn-lv-info">
      <view class="bn-lv-name">{{levelName}}</view>
      <view class="bn-lv-hint">{{levelHint}}</view>
      <view class="lv-bar dark"><view class="lv-fill" style="width:{{levelPct}}%"></view></view>
    </view>
  </view>
  <view class="bn-lv-row {{level >= item.lv ? 'on' : ''}}" wx:for="{{levels}}" wx:key="lv">
    <image class="bn-lv-ico" src="{{item.art}}" mode="aspectFit" />
    <view class="bn-lv-txt">
      <view><text class="bn-lv-n">{{item.name}}</text><text class="muted2" style="margin-left:12rpx">{{item.need}}</text></view>
      <view class="muted2" wx:if="{{item.perkText}}">{{item.perkText}}</view>
    </view>
    <text wx:if="{{level === item.lv}}" class="tag" style="margin:0">当前</text>
  </view>
</view>

<view class="sec-title" wx:if="{{ledger.length}}">旅豆账本 <text class="more">最近收支 · 每笔可查</text></view>
<view class="card fade-up" wx:if="{{ledger.length}}">
  <view class="bn-led" wx:for="{{ledger}}" wx:key="tx_no">
    <view class="bn-ico {{item.direction === 1 ? 'in' : 'out'}}">{{glyph[item.biz_type] || '豆'}}</view>
    <view class="bn-led-txt">
      <view class="bn-led-n">{{bizName[item.biz_type] || item.biz_type}}</view>
      <view class="muted2">{{item.created_at}}</view>
    </view>
    <text class="bn-led-amt {{item.direction === 1 ? 'in' : 'out'}}">{{item.direction === 1 ? '+' : '−'}}{{item.amount}}</text>
  </view>
</view>
<view class="note">{{bean ? bean.rule : '加载中…'}}</view>
