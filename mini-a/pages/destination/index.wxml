<view class="hero">
  <view class="hi">目的地</view>
  <view class="sub2">{{caption}}</view>
</view>
<view class="card dest-card" wx:for="{{list}}" wx:key="city_code" bindtap="goList" data-city="{{item.city_code}}">
  <image wx:if="{{item.cover}}" class="dest-cover" src="{{item.cover}}" mode="aspectFill" />
  <view wx:if="{{item.samplePhoto}}" class="muted2">场景参考图</view>
  <view class="row">
    <view style="flex:1">
      <b>{{item.cityName}}</b>
      <view class="muted2" wx:if="{{item.intro}}">{{item.intro}}</view>
      <view class="sub">{{item.products}} 条在架主题游 · ¥{{item.priceFromLabel}} 起</view>
    </view>
    <view style="color:var(--brand)">›</view>
  </view>
</view>
<view wx:if="{{!list.length && !loading}}" class="empty">目的地整备中，敬请期待</view>
