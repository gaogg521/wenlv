/* 统一三态组件：结构与配色对齐 app.wxss 设计系统，不新增色板 */
.uis { text-align: center; padding: 56rpx 32rpx 48rpx; }
.uis-compact { padding: 36rpx 24rpx 32rpx; }

.uis-ico { font-size: 76rpx; opacity: .5; margin-bottom: 10rpx; }
.uis-title { font-size: 30rpx; font-weight: 600; color: var(--ink); }
.uis-desc { margin-top: 12rpx; }
.uis-line { font-size: 24rpx; color: var(--sub); line-height: 1.8; }

/* 无资格三问 */
.uis-reasons { margin-top: 22rpx; text-align: left; background: var(--brand-soft); border-radius: 20rpx; padding: 6rpx 24rpx; }
.uis-reason { padding: 18rpx 0; border-bottom: 1rpx solid var(--line); }
.uis-reason:last-child { border-bottom: none; }
.uis-q { font-size: 24rpx; font-weight: 600; color: var(--brand-deep); }
.uis-q::before { content: ""; display: inline-block; width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--brand); margin-right: 12rpx; vertical-align: middle; }
.uis-a { font-size: 23rpx; color: var(--ink2); line-height: 1.7; margin-top: 6rpx; }

/* 权益示例预览 */
.uis-preview { margin-top: 22rpx; text-align: left; background: #fff; border: 1rpx dashed var(--sub); border-radius: 20rpx; padding: 20rpx 24rpx 12rpx; }
.uis-pt { font-size: 24rpx; font-weight: 600; color: var(--ink); margin-bottom: 6rpx; }
.uis-pr { display: flex; justify-content: space-between; padding: 14rpx 0; border-bottom: 1rpx solid var(--line); font-size: 24rpx; color: var(--ink2); }
.uis-pr:last-of-type { border-bottom: none; }
.uis-pv { font-weight: 600; color: var(--brand); font-variant-numeric: tabular-nums; }
.uis-pn { font-size: 20rpx; color: var(--sub); padding: 10rpx 0 8rpx; text-align: center; }

/* 动作区 */
.uis-actions { margin-top: 26rpx; display: flex; flex-direction: column; gap: 16rpx; align-items: center; }
.uis-btn { display: block; width: 100%; margin: 0; padding: 20rpx 0; font-size: 28rpx; min-height: 88rpx; line-height: 44rpx; }
.uis-btn.ghost { background: #fff; }

/* 加载骨架 */
.uis-sk { height: 150rpx; border-radius: 20rpx; margin: 0 0 18rpx;
  background: linear-gradient(90deg, #f0f1f3, #e8eaee, #f0f1f3); background-size: 200% 100%;
  animation: uis-sk 1.2s infinite; }
.uis-sk-short { height: 90rpx; width: 62%; margin: 0 auto; }
@keyframes uis-sk { 0% { background-position: 200% 0 } 100% { background-position: -200% 0 } }

/* 320px 窄屏：内边距收紧，字号不溢出 */
@media (max-width: 340px) {
  .uis { padding: 44rpx 22rpx 40rpx; }
  .uis-ico { font-size: 64rpx; }
  .uis-title { font-size: 28rpx; }
}
