
/* A-45：标签不换行（此前"手机号"被右侧按钮挤成竖排） */
.kv text:first-child { white-space: nowrap; flex-shrink: 0; }
/* A-45：为底部固定栏留出高度，避免盖住表单 */
page { padding-bottom: 160rpx; }
.bk-benefit{padding:24rpx;margin:18rpx 0;border:1rpx solid #e5e7df;border-radius:16rpx;background:#fafbf7}
.bk-benefit-top{display:flex;align-items:center;justify-content:space-between;gap:20rpx}
.bk-fee-title{font-size:26rpx;color:var(--ink,#263c34);line-height:1.5;font-weight:500;white-space:nowrap;flex-shrink:0}
.bk-benefit-top picker{flex-shrink:0}
.bk-benefit-picker{display:flex;align-items:center;gap:14rpx;min-height:60rpx;padding:0 4rpx 0 20rpx;color:#3b7357;font-size:24rpx;white-space:nowrap}
.bk-benefit-arrow{font-size:34rpx;line-height:1;color:#8c9e90}
.bk-benefit-detail{display:flex;justify-content:space-between;align-items:flex-start;gap:20rpx;margin-top:14rpx}
.bk-benefit-copy{min-width:0;flex:1}
.bk-benefit-rule{display:flex;flex-wrap:wrap;gap:4rpx 8rpx;font-size:28rpx;font-weight:600;color:#385b45;line-height:1.6}
.bk-benefit-rule text{white-space:nowrap}
.bk-benefit-amount{font-size:30rpx;font-weight:600;line-height:1.6;color:#2f7d5b;white-space:nowrap;flex-shrink:0;font-variant-numeric:tabular-nums}
.bk-fee-hint{font-size:22rpx;color:#8a948a;line-height:1.7;margin-top:8rpx;white-space:normal;word-break:normal}
.bk-benefit-error{font-size:23rpx;color:#b95338;line-height:1.6;margin-top:12rpx}
.bk-bean-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:22rpx 0;border-bottom:1rpx solid var(--line)}
.bk-bean-copy{flex:1;min-width:0}.bk-bean-row switch{flex-shrink:0}

.bk-phone { padding: 20rpx 0 8rpx; }
.bk-phone-label { display: block; margin-bottom: 12rpx; }
.bk-phone-controls { display: flex; align-items: center; gap: 16rpx; }
.bk-phone-input { flex: 1; min-width: 0; width: 0; height: 72rpx; padding: 0 16rpx; box-sizing: border-box; border: 1rpx solid var(--line); border-radius: 12rpx; }
.bk-phone-controls .phone-btn { flex: none; width: auto; min-height: 64rpx; padding: 0 18rpx; line-height: 64rpx; white-space: nowrap; }
.bk-phone-hint { display: block; margin-top: 10rpx; color: var(--sub); font-size: 22rpx; }
