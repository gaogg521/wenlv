<view wx:if="{{loading}}" class="skeleton" style="height:300rpx;margin-top:20rpx"></view>
<view wx:elif="{{error}}" class="card"><view>{{error}}</view><view class="btn ghost" bindtap="retry">重新加载</view></view>
<block wx:elif="{{p}}">
  <view class="card bk-head">
    <view class="dt-title" style="font-size:30rpx">{{p.title}}</view>
    <view class="muted2">{{p.days_desc || '1天'}} · 履约商户 {{p.merchant_name || '—'}}</view>
  </view>

  <view class="sec-title">1 · 选择出发日期</view>
  <view class="chips">
    <view class="chip {{sel === index ? 'on' : ''}} {{item.left_seats <= 0 ? 'full' : ''}}" wx:for="{{sessions}}" wx:key="id"
          bindtap="pick" data-i="{{index}}">{{item.depart_date}} · {{item.left_seats > 0 ? '余' + item.left_seats : '已满'}}</view>
    <view wx:if="{{!sessions.length}}" class="muted2" style="margin-left:8rpx">近期暂无团期</view>
  </view>
  <view class="muted2" wx:if="{{selView.extra}}" style="margin:8rpx 32rpx 0;font-size:22rpx;color:#1a9c6b">{{selView.extra}}</view>

  <view class="sec-title">2 · 出行人数与联系人</view>
  <view class="card">
    <view class="kv"><text>出行人数</text>
      <view class="qty-box">
        <text class="qty-btn {{qty <= 1 ? 'off' : ''}}" bindtap="subQty">－</text><text class="v" style="min-width:48rpx;text-align:center">{{qty}}</text><text class="qty-btn" bindtap="addQty">＋</text>
      </view></view>
    <view class="kv"><text>联系人</text>
      <input class="v input-r" placeholder="出行联系人姓名" value="{{contactName}}" bindinput="onName" /></view>
    <view class="kv"><text>手机号</text>
      <view style="display:flex;align-items:center;gap:16rpx">
        <input class="v input-r" type="number" maxlength="11" placeholder="用于接收出行通知"
          value="{{contactPhone}}" bindinput="onPhoneInput" style="flex:1;min-width:0" />
        <button class="phone-btn" open-type="getPhoneNumber" bindgetphonenumber="onPhone">一键获取</button>
      </view></view>
  </view>

  <view class="sec-title">3 · 费用确认</view>
  <view class="card" wx:if="{{priceSummary}}">
    <view class="kv"><text>单价 × 人数</text><text>¥{{priceSummary.unit}} × {{qty}}</text></view>
    <view class="kv"><text>活动费用</text><text>¥{{priceSummary.goods}}</text></view>
    <view class="kv"><text>旅豆抵扣 <text class="muted2">（余额 {{beanBal}}，最多抵 {{priceSummary.capYuan}} 元）</text></text>
      <switch checked="{{useBean}}" bindchange="toggleBean" color="#e87722" style="transform:scale(.8)" disabled="{{!beanBal}}" /></view>
    <view class="kv" wx:if="{{useBean && priceSummary.deduct !== '0.00'}}"><text>抵扣金额</text><text style="color:var(--green)">−¥{{priceSummary.deduct}}</text></view>
  </view>
  <view class="note">凭证核销前可申请全额退款，旅豆同步返还。最终金额以提交时的实时价格为准。</view>
  <view style="height:150rpx"></view>

  <view class="dt-bottom">
    <view class="dt-bottom-price"><text class="muted2" style="font-size:22rpx;font-weight:400">预计实付 </text><text class="rmb">¥</text>{{priceSummary ? priceSummary.pay : '—'}}</view>
    <view class="btn dt-cta {{submitting || !sessions.length ? 'off' : ''}}" bindtap="submit">{{submitting ? '正在提交…' : '提交订单并支付'}}</view>
  </view>
</block>
