<view wx:if="{{loading}}" class="skeleton" style="height:300rpx;margin-top:20rpx"></view>
<view wx:elif="{{error}}" class="card"><view>{{error}}</view><view class="btn ghost" bindtap="retry">重新加载</view></view>
<block wx:elif="{{p}}">
  <view class="card bk-head">
    <view class="dt-title" style="font-size:30rpx">{{p.title}}</view>
    <view class="muted2">{{p.days_desc || '1天'}} · 履约商户 {{p.merchant_name || '—'}}</view>
  </view>

  <view class="sec-title">1 · 选择出发日期</view>
  <view class="chips">
    <view class="chip {{sel === index ? 'on' : ''}} {{item.left_seats <= 0 ? 'full' : ''}}" wx:for="{{sessions}}" wx:key="id"
          bindtap="pick" data-i="{{index}}">{{item.depart_date}} · {{item.left_seats > 0 ? '余' + item.left_seats : '已满'}}</view>
    <view wx:if="{{!sessions.length}}" class="muted2" style="margin-left:8rpx">近期暂无团期</view>
  </view>
  <view class="muted2" wx:if="{{selView.extra}}" style="margin:8rpx 32rpx 0;font-size:22rpx;color:#1a9c6b">{{selView.extra}}</view>
  <view class="card sess-info" wx:if="{{selView.info}}">
    <view class="kv" wx:if="{{selView.info.gather_time}}"><text>集合时间</text><text class="v">{{selView.info.gather_time}}{{selView.info.end_time ? '，预计 ' + selView.info.end_time + ' 结束' : ''}}</text></view>
    <view class="kv" wx:if="{{selView.info.vehicle}}"><text>交通安排</text><text class="v">{{selView.info.vehicle}}</text></view>
    <view class="kv" wx:if="{{selView.info.sign_deadline}}"><text>报名截止</text><text class="v">{{selView.info.sign_deadline}}</text></view>
    <view class="muted2" wx:if="{{selView.info.note}}">⚠️ {{selView.info.note}}</view>
  </view>

  <view class="sec-title">2 · 出行人数与联系人</view>
  <view class="card">
    <view class="kv"><text>出行人数</text>
      <view class="qty-box">
        <text class="qty-btn {{qty <= 1 ? 'off' : ''}}" bindtap="subQty">－</text><text class="v" style="min-width:48rpx;text-align:center">{{qty}}</text><text class="qty-btn" bindtap="addQty">＋</text>
      </view></view>
    <view class="kv"><text>联系人</text>
      <input class="v input-r" placeholder="出行联系人姓名" value="{{contactName}}" bindinput="onName" maxlength="20" /></view>
    <view class="kv"><text>手机号</text>
      <view style="display:flex;align-items:center;gap:16rpx">
        <input class="v input-r" type="number" maxlength="11" placeholder="用于接收出行通知"
          value="{{contactPhone}}" bindinput="onPhoneInput" style="flex:1;min-width:0" />
        <button class="phone-btn" open-type="getPhoneNumber" bindgetphonenumber="onPhone">一键获取</button>
      </view></view>
  </view>

  <view class="sec-title" wx:if="{{p.hasInsurance}}">出行保障</view>
  <view class="card" wx:if="{{p.hasInsurance}}">
    <view class="kv">
      <view style="flex:1;min-width:0">
        <view><text style="font-weight:700">出行意外险</text><text class="muted2"> ¥{{p.insuranceFeeYuan}}/人</text></view>
        <view class="muted2" style="font-size:22rpx;margin-top:6rpx">{{p.insurance_note || '保险费用联调展示，未开通真实承保服务'}}</view>
        <view class="muted2" wx:if="{{p.insuranceMode === 'demo'}}">联调演示 · 支付不代表真实投保</view>
      </view>
      <switch checked="{{buyInsurance}}" bindchange="toggleInsurance" color="#e87722" style="transform:scale(.8)" />
    </view>
  </view>

  <view class="sec-title">3 · 费用确认</view>
  <view class="card" wx:if="{{priceSummary}}">
    <view class="kv"><text>单价 × 人数</text>
      <view style="display:flex;flex-direction:column;align-items:flex-end">
        <view style="display:flex;align-items:baseline;gap:8rpx">
          <text wx:if="{{priceSummary.showPromo}}" class="muted2" style="text-decoration:line-through;font-size:22rpx">¥{{priceSummary.originalUnit}}</text>
          <text>¥{{priceSummary.unit}} × {{qty}}</text>
        </view>
        <text wx:if="{{priceSummary.showPromo}}" class="muted2" style="font-size:22rpx;color:#1a9c6b">{{priceSummary.promoText}}</text>
      </view></view>
    <view class="kv"><text>活动费用</text><text>¥{{priceSummary.goods}}</text></view>
    <view class="bk-benefit">
      <view class="bk-benefit-top"><view class="bk-fee-title">自由豆补贴</view><picker mode="selector" range="{{freedomOptions}}" range-key="label" bindchange="chooseFreedom" disabled="{{pricing}}"><view class="bk-benefit-picker">{{pricing ? '试算中' : freedomRightId ? '更换' : '选择补贴'}}<text class="bk-benefit-arrow">›</text></view></picker></view>
      <view wx:if="{{freedomRightId && freedomSelected}}" class="bk-benefit-detail"><view class="bk-benefit-copy"><view class="bk-benefit-rule"><text>满{{freedomSelected.thresholdText}}元</text><text>减{{freedomSelected.discountText}}元</text></view><view class="bk-fee-hint">有效期至 {{freedomSelected.validTo}}</view></view><view class="bk-benefit-amount">{{pricing ? '—' : '−¥' + freedomDiscount}}</view></view>
      <view wx:else class="bk-fee-hint">{{freedomRows.length ? '可选择官方满减补贴' : '暂无适用的补贴'}}</view>
      <view class="bk-fee-hint" wx:if="{{freedomRightId}}">官方补贴可与旅豆抵扣同单使用，分别记账</view><view wx:if="{{freedomError}}" class="bk-benefit-error">{{freedomError}}</view>
    </view>
    <view class="bk-bean-row"><view class="bk-bean-copy"><view class="bk-fee-title">旅豆抵扣</view><view class="bk-fee-hint">余额 {{beanBal}} 豆 · 最多抵 {{priceSummary.capYuan}} 元（按最终实付计算）</view></view><switch checked="{{useBean}}" bindchange="toggleBean" color="#e87722" style="transform:scale(.8)" disabled="{{!beanBal}}" /></view>
    <view class="kv" wx:if="{{useBean && priceSummary.deduct !== '0.00'}}"><text>抵扣金额</text><text style="color:var(--green)">−¥{{priceSummary.deduct}}</text></view>
    <view class="kv" wx:if="{{priceSummary.showInsRow}}"><text>出行意外险</text><text>¥{{priceSummary.insurance}}</text></view>
  </view>
  <view class="card" wx:if="{{p.bookingRules && p.bookingRules.refundRules.length}}">
    <view class="fee-h">退改规则</view>
    <view class="hl-item" wx:for="{{p.bookingRules.refundRules}}" wx:key="*this"><text class="hl-dot">·</text>{{item}}</view>
  </view>
  <view class="note">退款按上述规则从实付金额中扣除手续费，抵扣的旅豆全额返还。最终金额以提交时的实时价格为准。</view>
  <view class="agree-row" style="display:flex;align-items:flex-start;gap:12rpx;padding:20rpx 32rpx">
    <checkbox-group bindchange="toggleAgree" style="transform:scale(.75);transform-origin:left center">
      <checkbox value="agree" checked="{{agree}}" style="transform:scale(.9)" />
    </checkbox-group>
    <view style="font-size:22rpx;color:var(--sub,#8a919c);line-height:1.6">已阅读并同意
      <text style="color:var(--brand,#e87722)" data-type="terms" bindtap="goDoc">《服务条款》</text>与
      <text style="color:var(--brand,#e87722)" data-type="privacy" bindtap="goDoc">《隐私政策》</text>，同意将出行信息用于订单与保险投保。</view>
  </view>
  <view style="height:150rpx"></view>

  <view class="dt-bottom">
    <view class="dt-bottom-price"><text class="muted2" style="font-size:22rpx;font-weight:400">预计实付 </text><text class="rmb">¥</text>{{priceSummary ? priceSummary.pay : '—'}}</view>
    <view class="btn dt-cta {{submitting || !sessions.length ? 'off' : ''}}" bindtap="submit">{{submitting ? '正在提交…' : '提交订单并支付'}}</view>
  </view>
</block>
