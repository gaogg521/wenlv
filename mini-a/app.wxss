/* ===== 向往的自由 · 小程序 A（游客主站）设计系统 =====
   主题：暖橙 #e87722 · 渐变 hero + 光斑 · 分类彩色封面 · 按压反馈 */
page {
  --brand: #e87722;
  --brand-deep: #d3610e;
  --brand-soft: #fff3e8;
  --ink: #1a2233;
  --ink2: #4d5665;
  --sub: #8a919c;
  --bg: #f6f6f8;
  --card: #ffffff;
  --line: #ecedf1;
  --green: #0f9d58;
  --red: #e5484d;
  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  --shadow: 0 2rpx 8rpx rgba(30,30,60,.05), 0 8rpx 24rpx rgba(30,30,60,.06);
}

/* ---- hero：渐变 + 光斑装饰 ---- */
.hero {
  position: relative; overflow: hidden; color: #fff;
  background: linear-gradient(140deg, #f59b4b 0%, #e87722 48%, #b85410 100%);
  padding: 44rpx 36rpx 56rpx; border-radius: 0 0 48rpx 48rpx;
}
.hero::before { content: ""; position: absolute; width: 320rpx; height: 320rpx; border-radius: 50%;
  background: rgba(255,255,255,.1); filter: blur(6rpx); right: -80rpx; top: -110rpx; }
.hero::after { content: ""; position: absolute; width: 200rpx; height: 200rpx; border-radius: 50%;
  background: rgba(255,255,255,.08); left: -50rpx; bottom: -80rpx; }
.hero .hi { font-size: 42rpx; font-weight: 800; letter-spacing: 1rpx; position: relative; }
.hero .sub2 { font-size: 24rpx; opacity: .9; margin-top: 10rpx; position: relative; }
.hero .hero-chip { display: inline-flex; align-items: center; gap: 8rpx; margin-top: 20rpx;
  font-size: 21rpx; background: rgba(255,255,255,.16); border: 1rpx solid rgba(255,255,255,.3);
  border-radius: 999rpx; padding: 8rpx 22rpx; backdrop-filter: blur(6rpx); position: relative; }
.hero .hero-chip .dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #ffe08a;
  box-shadow: 0 0 10rpx #ffe08a; animation: blink 1.8s infinite; }
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:.35} }

/* ---- 卡片 / 标题 ---- */
.card { background: var(--card); border-radius: 28rpx; margin: 20rpx 24rpx; padding: 30rpx; box-shadow: var(--shadow); }
.sec-title { font-size: 32rpx; font-weight: 800; margin: 36rpx 24rpx 18rpx; display: flex; align-items: center; gap: 12rpx; }
.sec-title::before { content: ""; width: 8rpx; height: 30rpx; border-radius: 4rpx; background: var(--brand); }
.sec-title .more { margin-left: auto; font-size: 22rpx; color: var(--sub); font-weight: 400; }

/* ---- 分类 chips ---- */
.chips { display: flex; flex-wrap: nowrap; gap: 14rpx; margin: 20rpx 24rpx; overflow-x: auto; padding-bottom: 6rpx; }
.chips::-webkit-scrollbar { display: none; }
.chip { flex-shrink: 0; padding: 12rpx 30rpx; background: #fff; border-radius: 999rpx; font-size: 24rpx; color: var(--ink2); border: 1rpx solid var(--line); }
.chip.on { background: var(--brand); color: #fff; border-color: var(--brand); font-weight: 600;
  box-shadow: 0 6rpx 18rpx rgba(232,119,34,.35); }

/* ---- 线路卡片 ---- */
.tour-item { display: flex; gap: 22rpx; background: #fff; border-radius: 28rpx; margin: 0 24rpx 20rpx; padding: 22rpx;
  box-shadow: var(--shadow); transition: transform .15s; }
.tour-item:active { transform: scale(.98); background: #fffdfb; }
.tour-cover { width: 200rpx; height: 172rpx; border-radius: 18rpx; flex-shrink: 0; position: relative; overflow: hidden;
  display: flex; align-items: center; justify-content: center; font-size: 64rpx; color: rgba(255,255,255,.9); }
.tour-cover::after { content: ""; position: absolute; width: 130rpx; height: 130rpx; border-radius: 50%;
  background: rgba(255,255,255,.16); right: -40rpx; top: -40rpx; }
.cover-0 { background: linear-gradient(135deg, #f59b4b, #e87722); }
.cover-1 { background: linear-gradient(135deg, #34c3a2, #0e9f8a); }
.cover-2 { background: linear-gradient(135deg, #7b9df0, #5271c4); }
.cover-3 { background: linear-gradient(135deg, #f2778d, #d94f6c); }
.cover-4 { background: linear-gradient(135deg, #b58cf2, #8250d4); }
.tour-title { font-size: 30rpx; font-weight: 700; }
.tour-desc { font-size: 24rpx; color: var(--sub); margin-top: 8rpx; }
.tour-price { color: var(--brand); font-weight: 800; font-size: 36rpx; margin-top: 12rpx; font-variant-numeric: tabular-nums; }
.tour-price .rmb { font-size: 22rpx; font-weight: 600; margin-right: 2rpx; }
.tour-price .u { font-size: 21rpx; font-weight: 400; color: var(--sub); margin-left: 12rpx; }
.tag { display: inline-block; font-size: 20rpx; padding: 5rpx 16rpx; border-radius: 999rpx; background: var(--brand-soft); color: var(--brand-deep); margin-right: 10rpx; margin-top: 8rpx; }
.tag.blue { background: #e8effd; color: #1d4ed8; }

/* ---- 按钮 ---- */
.btn { background: linear-gradient(135deg, #f59b4b, #e87722); color: #fff; border-radius: 999rpx; text-align: center;
  padding: 24rpx 0; font-size: 30rpx; font-weight: 700; margin: 24rpx; letter-spacing: 2rpx;
  box-shadow: 0 10rpx 26rpx rgba(232,119,34,.35); }
.btn.ghost { background: #fff; color: var(--brand); border: 1.5rpx solid var(--brand); box-shadow: none; }
.btn.sm { display: inline-block; margin: 0; padding: 12rpx 34rpx; font-size: 24rpx; }

/* ---- 行 / 数值 ---- */
.kv { display: flex; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid var(--line); font-size: 26rpx; align-items: center; }
.kv:last-child { border-bottom: none; }
.kv .v { font-weight: 600; text-align: right; }
.money { color: var(--brand); font-weight: 700; }
.muted2 { font-size: 23rpx; color: var(--sub); }

/* ---- 旅豆 ---- */
.bean-num { font-size: 84rpx; font-weight: 800; color: #fff; text-shadow: 0 4rpx 16rpx rgba(0,0,0,.18); position: relative; }
.bean-rules { display: flex; gap: 14rpx; margin: -40rpx 24rpx 8rpx; position: relative; z-index: 2; }
.bean-rule { flex: 1; background: #fff; border-radius: 20rpx; padding: 20rpx 16rpx; text-align: center; box-shadow: 0 8rpx 24rpx rgba(30,30,60,.1); }
.bean-rule .bi { font-size: 34rpx; }
.bean-rule .bl { font-size: 20rpx; color: var(--sub); margin-top: 6rpx; }
.bean-rule .bv { font-size: 26rpx; font-weight: 700; color: var(--ink); margin-top: 4rpx; }

/* ---- 通用 ---- */
.empty { text-align: center; color: var(--sub); padding: 90rpx 0; font-size: 26rpx; }
.empty .e-ico { font-size: 68rpx; margin-bottom: 14rpx; opacity: .4; }
.note { font-size: 22rpx; color: var(--sub); text-align: center; padding: 26rpx; line-height: 1.7; }
.fade-up { animation: fadeup .32s ease-out both; }
@keyframes fadeup { from { opacity: 0; transform: translateY(16rpx); } }
.skeleton { height: 160rpx; background: linear-gradient(90deg,#f0f1f3,#e8eaee,#f0f1f3); background-size: 200% 100%; animation: sk 1.2s infinite; border-radius: 20rpx; margin: 20rpx 24rpx; }
@keyframes sk { 0%{background-position:200% 0} 100%{background-position:-200% 0} }

/* ---- 支付结果 ---- */
.pay-hero { text-align: center; padding: 70rpx 30rpx 50rpx; }
.pay-ico { width: 140rpx; height: 140rpx; margin: 0 auto 24rpx; border-radius: 50%; font-size: 70rpx;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #e3f6ec, #c8ecd9); animation: popin .4s ease-out; }
@keyframes popin { from { transform: scale(.4); opacity: 0; } }

/* ---- 输入/头像/客服（me 页与下单页） ---- */
.input-r { text-align: right; min-width: 240rpx; }
.phone-btn { font-size: 22rpx; line-height: 1.6; padding: 6rpx 20rpx; margin: 0; background: var(--brand); color: #fff; border-radius: 999rpx; }
.phone-btn::after { border: none; }
.avatar-btn { width: 96rpx; height: 96rpx; padding: 0; margin: 0; border-radius: 50%; overflow: hidden; background: transparent; }
.avatar-btn::after { border: none; }
.avatar-img { width: 96rpx; height: 96rpx; border-radius: 50%; display: block; }
.avatar-empty { background: linear-gradient(135deg, var(--brand), #f5a623); }
.nick-input { font-size: 34rpx; font-weight: 700; min-width: 200rpx; }
.contact-btn { width: 100%; background: transparent; text-align: left; font-weight: inherit; line-height: inherit; padding: 20rpx 0; margin: 0; border-radius: 0; display: flex; justify-content: space-between; border-bottom: 1rpx solid var(--line); font-size: 26rpx; }
.contact-btn::after { border: none; }

/* ---- 详情页：图集/内容/评价 ---- */
.gallery { width: 100%; height: 460rpx; }
.g-count { position: relative; margin: -60rpx 24rpx 0; text-align: right; color: #fff; font-size: 20rpx; text-shadow: 0 2rpx 8rpx rgba(0,0,0,.4); z-index: 2; }
.book-bar { display: flex; justify-content: space-between; align-items: center; background: #fff; border-radius: 28rpx; margin: -30rpx 24rpx 0; padding: 24rpx 28rpx; position: relative; z-index: 2; box-shadow: var(--shadow); }
.rating-row { display: flex; align-items: center; gap: 14rpx; margin: 20rpx 24rpx 0; }
.star { color: var(--brand); font-weight: 800; font-size: 30rpx; }
.star-sm { color: var(--brand); font-weight: 700; font-size: 24rpx; }
.hl-item { display: flex; gap: 12rpx; padding: 10rpx 0; font-size: 26rpx; color: var(--ink2); }
.hl-dot { color: var(--brand); font-size: 22rpx; margin-top: 4rpx; }
.hl-dot.ok { color: var(--green); }
.rich-p { font-size: 26rpx; color: var(--ink2); line-height: 1.8; }
.card.safety { background: #fff8f1; border: 1rpx solid #ffd9b8; }
.rv-item { padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.rv-item:last-child { border-bottom: none; }
.pick-star { font-size: 44rpx; color: #d8dde3; }
.pick-star.on { color: var(--brand); }
.rv-input { width: 100%; min-height: 140rpx; background: #f8fafd; border: 1.5rpx solid var(--line); border-radius: 16rpx; padding: 18rpx 22rpx; box-sizing: border-box; font-size: 26rpx; }
.tour-img { width: 200rpx; height: 172rpx; border-radius: 18rpx; flex-shrink: 0; background: #eef1f5; }
.search-bar { display: flex; gap: 14rpx; margin: 4rpx 24rpx 16rpx; align-items: center; }
.search-input { flex: 1; background: #fff; border: 1.5rpx solid var(--line); border-radius: 999rpx; padding: 14rpx 28rpx; font-size: 25rpx; }
.search-btn { flex-shrink: 0; background: var(--brand); color: #fff; border-radius: 999rpx; padding: 12rpx 32rpx; font-size: 24rpx; font-weight: 600; }
.lv-row { display: flex; align-items: center; gap: 14rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--line); }
.lv-row:last-child { border-bottom: none; }
.lv-badge { font-size: 20rpx; font-weight: 700; border-radius: 8rpx; padding: 6rpx 14rpx; background: #eef1f5; color: var(--sub); }
.lv-badge.on { background: var(--brand); color: #fff; }

/* 2026-10 产品体验：编辑式首页与统一状态 */
.home-intro{padding:44rpx 36rpx 32rpx;background:#f6efe5;color:#253c35;position:relative;overflow:hidden}
.eyebrow{font-size:19rpx;letter-spacing:3rpx;color:#786b59;font-weight:600}
.home-title{font-size:62rpx;line-height:1.22;font-weight:800;margin:24rpx 0;letter-spacing:-2rpx}.home-title text{display:block;color:#d56b32}
.home-caption{font-size:25rpx;line-height:1.8;color:#766c60;max-width:560rpx}
.home-search{background:#fff;padding:25rpx 22rpx;border-radius:18rpx;margin-top:30rpx;font-size:24rpx;color:#8c8275;display:flex;justify-content:space-between}.home-search text{color:#c46430;font-weight:600}
.home-destination{display:flex;justify-content:space-between;margin-top:25rpx;font-size:22rpx;color:#69736a}.home-destination text{color:#2f5748}
.theme-grid{display:flex;gap:12rpx;padding:24rpx}.theme-tile{background:#fff;flex:1;min-width:0;padding:22rpx 12rpx;border:1rpx solid #eee6da;border-radius:18rpx}.theme-symbol{font-size:38rpx;color:#b86a39}.theme-name{font-size:24rpx;font-weight:700;margin-top:12rpx}.theme-sub{font-size:18rpx;color:#8a8175;margin-top:7rpx}
.home-footer{text-align:center;padding:40rpx 24rpx 70rpx;font-size:24rpx;color:#71695d}.home-footer view{font-size:20rpx;letter-spacing:3rpx;margin-top:12rpx;color:#a59b8c}
.btn[disabled]{opacity:.5}.state-error{padding:40rpx;text-align:center;color:#8c492f}.state-error .btn{margin-top:20rpx}
